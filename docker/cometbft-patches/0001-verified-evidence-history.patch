+func TestHistoryAdversarialValidatorIdentity(t *testing.T) {
+	mutations := map[string]func(*testing.T, *HistoryRecord){
+		"unhashed address": func(t *testing.T, record *HistoryRecord) {
+			before := record.Validators.Hash()
+			record.Validators.Validators[0].Address[0] ^= 0xff
+			require.Equal(t, before, record.Validators.Hash())
+		},
+		"malformed key": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0].PubKey = ed25519.PubKey{1}
+		},
+		"nil key": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0].PubKey = nil
+		},
+		"nil validator": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0] = nil
+		},
+		"duplicate validator": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators = append(record.Validators.Validators, record.Validators.Validators[0])
+		},
+		"zero power": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0].VotingPower = 0
+		},
+		"valid power with wrong hash": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0].VotingPower++
+		},
+		"excessive power": func(_ *testing.T, record *HistoryRecord) {
+			record.Validators.Validators[0].VotingPower = types.MaxTotalVotingPower + 1
+		},
+		"nil header": func(_ *testing.T, record *HistoryRecord) { record.Header = nil },
+		"nil commit": func(_ *testing.T, record *HistoryRecord) { record.Commit = nil },
+		"nil set":    func(_ *testing.T, record *HistoryRecord) { record.Validators = nil },
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			anchor, records := historyTestChain(t, 3)
+			bad := historyTestProvider(func(_ context.Context, height int64) (HistoryRecord, error) {
+				record := historyCopy(t, records[height])
+				mutate(t, &record)
+				return record, nil
+			})
+			_, err := FetchHistory(context.Background(), anchor,
+				types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour},
+				[]HistoryProvider{bad}, DefaultHistoryLimits(), func(HistoryRecord) error {
+					t.Fatal("unauthenticated validator data was published")
+					return nil
+				})
+			require.Error(t, err)
+			if name == "valid power with wrong hash" {
+				require.ErrorContains(t, err, "validator hash mismatch")
+			}
+		})
+	}
+}
+
+func TestHistoryAdversarialCommitMetadataIsNotCoveredByCommitHash(t *testing.T) {
+	mutations := map[string]func(*types.Commit){
