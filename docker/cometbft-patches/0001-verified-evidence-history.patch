+func TestHistoryResumeRestoredAppBeforeAnyCoreCheckpoint(t *testing.T) {
+	for _, corePublished := range []bool{false, true} {
+		t.Run(fmt.Sprint(corePublished), func(t *testing.T) {
+			trusted, commit, query := historyResumableState(t)
+			db := dbm.NewMemDB()
+			stateStore := sm.NewStore(db, sm.StoreOptions{})
+			blocks := store.NewBlockStore(dbm.NewMemDB())
+			old := sm.State{ChainID: trusted.ChainID, InitialHeight: 1}
+			if corePublished {
+				require.NoError(t, stateStore.Bootstrap(trusted))
+				old = trusted
+			}
+			require.NoError(t, writeHistoryPending(db, trusted.ChainID, 0))
+			calls := 0
+			resumed, err := resumeEvidenceHistoryUsing(context.Background(), db, stateStore, blocks, old, query, func(_ context.Context, height int64) (sm.State, []byte, *types.Commit, error) {
+				calls++
+				require.Equal(t, int64(42), height)
+				pending, err := readHistoryRequirement(db)
+				require.NoError(t, err)
+				require.True(t, pending.Pending)
+				return trusted, bytes.Repeat([]byte{3}, 32), commit, nil
+			})
+			require.NoError(t, err)
+			require.Equal(t, 1, calls)
+			require.Equal(t, int64(42), resumed.LastBlockHeight)
+			persisted, err := stateStore.Load()
+			require.NoError(t, err)
+			require.Equal(t, int64(42), persisted.LastBlockHeight)
+			require.Equal(t, commit.Hash(), blocks.LoadSeenCommit(42).Hash())
+			ready, err := readHistoryRequirement(db)
+			require.NoError(t, err)
+			require.False(t, ready.Pending)
+			for restart := 0; restart < 2; restart++ {
+				require.NoError(t, stateStore.SetOfflineStateSyncHeight(0))
+				floor, err := loadHistoryBlocksyncHeight(db, blocks, resumed)
+				require.NoError(t, err)
+				require.NotPanics(t, func() {
+					_, err := createBlocksyncReactor(true, cfg.DefaultConfig(), resumed, nil, blocks, nil, floor, log.NewNopLogger(), bc.NopMetrics())
+					require.NoError(t, err)
+				}, "a restored checkpoint must construct its real blocksync reactor after every legacy floor reset")
+				require.Equal(t, int64(42), floor)
+			}
+		})
+	}
+}
