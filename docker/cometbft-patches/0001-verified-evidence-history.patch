+func (p *http) validatorPage(ctx context.Context, height *int64, page, perPage *int) (*coretypes.ResultValidators, error) {
+	for attempt := 1; attempt <= maxRetryAttempts; attempt++ {
+		res, err := p.client.Validators(ctx, height, page, perPage)
+		switch {
+		case err == nil:
+			return res, nil
+		case regexpTooHigh.MatchString(err.Error()):
+			return nil, provider.ErrHeightTooHigh
+		case regexpMissingHeight.MatchString(err.Error()):
+			return nil, provider.ErrLightBlockNotFound
+		case attempt == maxRetryAttempts:
+			return nil, provider.ErrNoResponse
+		case regexpTimedOut.MatchString(err.Error()):
+			time.Sleep(backoffTimeout(uint16(attempt)))
+		default:
+			return nil, err
+		}
+	}
+	return nil, provider.ErrNoResponse
+}
+
+func validateLightValidatorPage(res *coretypes.ResultValidators, height int64, total, collected int) error {
+	if res == nil || res.BlockHeight != height {
+		return fmt.Errorf("invalid validator page height")
+	}
+	if err := validateLightPageTotal(res.Total, total); err != nil {
+		return err
+	}
+	want := min(100, res.Total-collected)
+	if want <= 0 || res.Count != want || len(res.Validators) != want {
+		return fmt.Errorf("inconsistent validator page size")
+	}
+	return nil
+}
+
+func validateLightPageTotal(actual, previous int) error {
+	if actual <= 0 || actual > 10000 {
+		return fmt.Errorf("invalid validator page total")
+	}
+	if previous >= 0 && actual != previous {
+		return fmt.Errorf("validator page total changed")
+	}
+	return nil
+}
