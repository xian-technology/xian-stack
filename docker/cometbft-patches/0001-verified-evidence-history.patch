+func TestHistoryResumeFailureKeepsIndependentJournalPending(t *testing.T) {
+	trusted, commit, query := historyResumableState(t)
+	for _, failure := range []string{"fetch", "cancel", "wronghash", "corewrite"} {
+		t.Run(failure, func(t *testing.T) {
+			db := dbm.NewMemDB()
+			base := sm.NewStore(db, sm.StoreOptions{})
+			var stateStore sm.Store = base
+			if failure == "corewrite" {
+				stateStore = historyBootstrapFailureStore{Store: base}
+			}
+			require.NoError(t, writeHistoryPending(db, trusted.ChainID, 0))
+			old := sm.State{ChainID: trusted.ChainID, InitialHeight: 1}
+			_, err := resumeEvidenceHistoryUsing(context.Background(), db, stateStore, store.NewBlockStore(dbm.NewMemDB()), old, query, func(context.Context, int64) (sm.State, []byte, *types.Commit, error) {
+				result := trusted
+				if failure == "fetch" {
+					return result, nil, nil, fmt.Errorf("provider failed")
+				}
+				if failure == "cancel" {
+					return result, nil, nil, context.Canceled
+				}
+				if failure == "wronghash" {
+					result.AppHash = []byte("wrong")
+				}
+				return result, bytes.Repeat([]byte{3}, 32), commit, nil
+			})
+			require.Error(t, err)
+			pending, err := readHistoryRequirement(db)
+			require.NoError(t, err)
+			require.True(t, pending.Pending)
+			persisted, err := base.Load()
+			require.NoError(t, err)
+			require.True(t, persisted.IsEmpty())
+		})
+	}
+}
