+			_, err := FetchHistory(context.Background(), anchor,
+				types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour},
+				[]HistoryProvider{bad}, DefaultHistoryLimits(), func(HistoryRecord) error {
+					t.Fatal("forged commit metadata was published")
