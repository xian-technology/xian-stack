+package statesync
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	cmttest "github.com/cometbft/cometbft/internal/test"
+	cmtjson "github.com/cometbft/cometbft/libs/json"
+	cmtversion "github.com/cometbft/cometbft/proto/tendermint/version"
+	"github.com/cometbft/cometbft/types"
+	"github.com/cometbft/cometbft/version"
+)
+
+type historyTestProvider func(context.Context, int64) (HistoryRecord, error)
+
+func (p historyTestProvider) Fetch(ctx context.Context, height int64) (HistoryRecord, error) {
+	return p(ctx, height)
+}
+
+func historyTestChain(t *testing.T, height int64) (HistoryAnchor, map[int64]HistoryRecord) {
+	return historyTestChainAt(t, height, time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC))
+}
+
+func historyTestChainAt(t *testing.T, height int64, start time.Time) (HistoryAnchor, map[int64]HistoryRecord) {
+	t.Helper()
+	pv := types.NewMockPV()
+	pub, err := pv.GetPubKey()
+	require.NoError(t, err)
+	vals := types.NewValidatorSet([]*types.Validator{types.NewValidator(pub, 10)})
+	records := make(map[int64]HistoryRecord)
+	var previous types.BlockID
+	var previousCommit *types.Commit
+	for h := int64(1); h <= height+1; h++ {
+		header := &types.Header{
+			Version: cmtversion.Consensus{Block: version.BlockProtocol},
+			ChainID: "history-test", Height: h,
+			Time:        start.Add(time.Duration(h) * time.Nanosecond),
+			LastBlockID: previous, LastCommitHash: previousCommit.Hash(),
+			ValidatorsHash: vals.Hash(), NextValidatorsHash: vals.Hash(),
+			ProposerAddress: pub.Address(),
+		}
+		id := cmttest.MakeBlockIDWithHash(header.Hash())
+		commit, err := cmttest.MakeCommit(id, h, 0, vals, []types.PrivValidator{pv}, header.ChainID, header.Time)
+		require.NoError(t, err)
+		records[h] = HistoryRecord{Header: header, Validators: vals, Commit: commit}
+		previous, previousCommit = id, commit
+	}
+	return HistoryAnchor{Header: records[height].Header, NextHeader: records[height+1].Header, InitialHeight: 1}, records
+}
+
+func historyCopy(t *testing.T, record HistoryRecord) HistoryRecord {
+	t.Helper()
+	encoded, err := cmtjson.Marshal(record)
+	require.NoError(t, err)
+	var result HistoryRecord
+	require.NoError(t, cmtjson.Unmarshal(encoded, &result))
+	return result
+}
+
+func historyProvider(t *testing.T, records map[int64]HistoryRecord) HistoryProvider {
+	return historyTestProvider(func(_ context.Context, height int64) (HistoryRecord, error) {
+		record, ok := records[height]
+		if !ok {
+			return HistoryRecord{}, errors.New("missing height")
+		}
+		return historyCopy(t, record), nil
+	})
+}
+
+func TestHistoryRetainsUntilBothAgeBoundsExpire(t *testing.T) {
+	for _, ages := range []struct {
+		blocks   int64
+		duration time.Duration
+	}{{2, 5 * time.Nanosecond}, {5, 2 * time.Nanosecond}, {2, 2 * time.Nanosecond}} {
+		t.Run(ages.duration.String(), func(t *testing.T) {
+			anchor, records := historyTestChain(t, 8)
+			var retained []int64
+			result, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: ages.blocks, MaxAgeDuration: ages.duration}, []HistoryProvider{historyProvider(t, records)}, DefaultHistoryLimits(), func(record HistoryRecord) error {
+				retained = append(retained, record.Header.Height)
+				return nil
+			})
+			require.NoError(t, err)
+			age := ages.blocks
+			if int64(ages.duration) > age {
+				age = int64(ages.duration)
+			}
+			require.Equal(t, 8-age, result.LowestHeight)
+			require.Len(t, retained, int(age+1))
+			require.Equal(t, int64(len(retained)), result.Count)
+			require.Positive(t, result.Bytes)
+		})
+	}
+}
+
+func TestHistoryRejectsUnauthenticatedProviderBeforePublicationAndRetries(t *testing.T) {
+	anchor, records := historyTestChain(t, 5)
+	bad := historyTestProvider(func(_ context.Context, height int64) (HistoryRecord, error) {
+		record := historyCopy(t, records[height])
+		record.Header.AppHash = []byte("forged")
+		return record, nil
+	})
+	var published []int64
+	result, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{bad, historyProvider(t, records)}, DefaultHistoryLimits(), func(record HistoryRecord) error {
+		require.Equal(t, records[record.Header.Height].Header.Hash(), record.Header.Hash())
+		published = append(published, record.Header.Height)
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, int64(1), result.LowestHeight)
+	require.Equal(t, []int64{5, 4, 3, 2, 1}, published)
+	_, err = FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{bad}, DefaultHistoryLimits(), func(HistoryRecord) error { t.Fatal("published unverified record"); return nil })
+	require.Error(t, err)
+}
+
+func TestHistoryRequiresDurableNextHeaderCommitHash(t *testing.T) {
+	anchor, records := historyTestChain(t, 5)
+	bad := historyTestProvider(func(_ context.Context, height int64) (HistoryRecord, error) {
+		record := historyCopy(t, records[height])
+		record.Commit.Signatures[0].Timestamp = record.Commit.Signatures[0].Timestamp.Add(time.Nanosecond)
+		return record, nil
+	})
+	_, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{bad}, DefaultHistoryLimits(), func(HistoryRecord) error { t.Fatal("published forged commit"); return nil })
+	require.Error(t, err)
+}
+
+func TestHistoryFailsRatherThanTruncatingAndCanResumeIdempotently(t *testing.T) {
+	anchor, records := historyTestChain(t, 5)
+	params := types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}
+	stored := make(map[int64][]byte)
+	emit := func(record HistoryRecord) error {
+		encoded, err := cmtjson.Marshal(record)
+		if previous, exists := stored[record.Header.Height]; exists {
+			require.Equal(t, previous, encoded)
+		}
+		stored[record.Header.Height] = encoded
+		return err
+	}
+	limits := DefaultHistoryLimits()
+	limits.MaxRecords = 2
+	_, err := FetchHistory(context.Background(), anchor, params, []HistoryProvider{historyProvider(t, records)}, limits, emit)
+	require.Error(t, err)
+	require.Len(t, stored, 2)
+	result, err := FetchHistory(context.Background(), anchor, params, []HistoryProvider{historyProvider(t, records)}, DefaultHistoryLimits(), emit)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), result.LowestHeight)
+	require.Len(t, stored, 5)
+	limits = DefaultHistoryLimits()
+	limits.MaxBytes = result.Bytes
+	exact, err := FetchHistory(context.Background(), anchor, params, []HistoryProvider{historyProvider(t, records)}, limits, emit)
+	require.NoError(t, err)
+	require.Equal(t, result, exact)
+	limits.MaxBytes--
+	_, err = FetchHistory(context.Background(), anchor, params, []HistoryProvider{historyProvider(t, records)}, limits, emit)
+	require.Error(t, err)
+	limits = DefaultHistoryLimits()
+	limits.MaxBytes = 1
+	_, err = FetchHistory(context.Background(), anchor, params, []HistoryProvider{historyProvider(t, records)}, limits, func(HistoryRecord) error { t.Fatal("exceeded byte budget"); return nil })
+	require.Error(t, err)
+}
+
+func TestHistoryAcceptsTimestampsBeyondUnixNanoRange(t *testing.T) {
+	for _, year := range []int{1, 2500, 9999} {
+		anchor, records := historyTestChainAt(t, 3, time.Date(year, 1, 1, 0, 0, 0, 0, time.UTC))
+		result, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{historyProvider(t, records)}, DefaultHistoryLimits(), func(record HistoryRecord) error {
+			require.Equal(t, year, record.Header.Time.Year())
+			return nil
+		})
+		require.NoError(t, err)
+		require.Equal(t, int64(3), result.Count)
+	}
+}
+
+func TestHistoryRPCBoundsResponseAndTime(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = w.Write([]byte(strings.Repeat(" ", 4096))) }))
+	defer server.Close()
+	limits := DefaultHistoryLimits()
+	limits.MaxResponseBytes = 128
+	provider, err := NewHistoryRPCProvider(server.URL, limits)
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 3)
+	require.ErrorContains(t, err, "response")
+	slow := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) { <-r.Context().Done() }))
+	defer slow.Close()
+	limits.RequestTimeout = 20 * time.Millisecond
+	provider, err = NewHistoryRPCProvider(slow.URL, limits)
+	require.NoError(t, err)
+	started := time.Now()
+	_, err = provider.Fetch(context.Background(), 3)
+	require.Error(t, err)
+	require.Less(t, time.Since(started), time.Second)
+}
+
+func TestHistoryTraversalDoesNotShareMutableHeaderWithSink(t *testing.T) {
+	anchor, records := historyTestChain(t, 5)
+	result, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{historyProvider(t, records)}, DefaultHistoryLimits(), func(record HistoryRecord) error {
+		if record.Header.Height > 1 {
+			record.Header.LastBlockID.Hash[0] ^= 0xff
+			record.Header.LastCommitHash[0] ^= 0xff
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, int64(1), result.LowestHeight)
+	require.Equal(t, int64(5), result.Count)
+}
+
+func TestHistoryRPCRejectsAmbiguousOrCredentialBearingEndpoints(t *testing.T) {
+	for _, server := range []string{"", "://bad", "ftp://localhost", "http:///missing", "http://user:secret@localhost", "http://localhost?height=2", "http://localhost#fragment"} {
+		_, err := NewHistoryRPCProvider(server, DefaultHistoryLimits())
+		require.Error(t, err, server)
+	}
+	for _, server := range []string{"localhost:26657", "http://127.0.0.1:26657/rpc", "https://example.invalid/rpc"} {
+		_, err := NewHistoryRPCProvider(server, DefaultHistoryLimits())
+		require.NoError(t, err, server)
+	}
+}
+
+func TestHistoryRejectsInvalidAnchorBeforeRPCOrPublication(t *testing.T) {
+	mutations := map[string]func(*HistoryAnchor){
+		"missing header":           func(a *HistoryAnchor) { a.Header = nil },
+		"missing next":             func(a *HistoryAnchor) { a.NextHeader = nil },
+		"zero initial height":      func(a *HistoryAnchor) { a.InitialHeight = 0 },
+		"initial above checkpoint": func(a *HistoryAnchor) { a.InitialHeight = 4 },
+		"height overflow":          func(a *HistoryAnchor) { a.Header.Height = math.MaxInt64 },
+		"invalid next header":      func(a *HistoryAnchor) { a.NextHeader.Version.Block = 0 },
+		"next wrong height":        func(a *HistoryAnchor) { a.NextHeader.Height++ },
+		"next foreign chain":       func(a *HistoryAnchor) { a.NextHeader.ChainID = "foreign" },
+		"broken link":              func(a *HistoryAnchor) { a.Header.AppHash = []byte("changed") },
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			anchor, records := historyTestChain(t, 3)
+			anchor.Header = historyCopy(t, records[3]).Header
+			anchor.NextHeader = historyCopy(t, records[4]).Header
+			mutate(&anchor)
+			provider := historyTestProvider(func(context.Context, int64) (HistoryRecord, error) {
+				t.Fatal("queried RPC with invalid anchor")
+				return HistoryRecord{}, nil
+			})
+			_, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{provider}, DefaultHistoryLimits(), func(HistoryRecord) error { t.Fatal("published invalid anchor"); return nil })
+			require.Error(t, err)
+		})
+	}
+}
+
+func historyRPCBody(t *testing.T, result any) []byte {
+	t.Helper()
+	payload, err := cmtjson.Marshal(result)
+	require.NoError(t, err)
+	body, err := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": 1, "result": json.RawMessage(payload)})
+	require.NoError(t, err)
+	return body
+}
+
+func TestHistoryDedicatedFallbackIsAuthenticated(t *testing.T) {
+	for _, forged := range []bool{false, true} {
+		anchor, records := historyTestChain(t, 3)
+		var standard, dedicated atomic.Int64
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if strings.HasSuffix(r.URL.Path, "/commit") {
+				standard.Add(1)
+				w.WriteHeader(http.StatusNotFound)
+				return
+			}
+			require.Equal(t, "/rpc/evidence_history", r.URL.Path)
+			dedicated.Add(1)
+			height, err := strconv.ParseInt(r.URL.Query().Get("height"), 10, 64)
+			require.NoError(t, err)
+			record := historyCopy(t, records[height])
+			if forged {
+				record.Header.AppHash = []byte("forged")
+			}
+			_, _ = w.Write(historyRPCBody(t, record))
+		}))
+		limits := DefaultHistoryLimits()
+		provider, err := NewHistoryRPCProvider(server.URL+"/rpc", limits)
+		require.NoError(t, err)
+		var emitted int
+		result, err := FetchHistory(context.Background(), anchor, types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour}, []HistoryProvider{provider}, limits, func(HistoryRecord) error { emitted++; return nil })
+		if forged {
+			require.Error(t, err)
+			require.Zero(t, emitted)
+		} else {
+			require.NoError(t, err)
+			require.Equal(t, int64(3), result.Count)
+			require.Equal(t, 3, emitted)
+		}
+		require.Positive(t, standard.Load())
+		require.Positive(t, dedicated.Load())
+		server.Close()
+	}
+}
+
+func TestHistoryDedicatedFallbackSharesTheRecordByteBudget(t *testing.T) {
+	_, records := historyTestChain(t, 3)
+	standard := []byte(`{"jsonrpc":"2.0","id":1,"error":{"code":-32603,"message":"not retained"}}`)
+	dedicated := historyRPCBody(t, records[3])
+	var requests atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if strings.HasSuffix(r.URL.Path, "/commit") {
+			_, _ = w.Write(standard)
+		} else {
+			_, _ = w.Write(dedicated)
+		}
+	}))
+	defer server.Close()
+	limits := DefaultHistoryLimits()
+	limits.MaxResponseBytes = int64(len(standard) + len(dedicated) - 1)
+	provider, err := NewHistoryRPCProvider(server.URL, limits)
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 3)
+	require.ErrorContains(t, err, "byte limit")
+	require.Equal(t, int64(2), requests.Load())
+}
+
+func TestHistoryRPCErrorsDoNotExposeResponseOrURLSecrets(t *testing.T) {
+	const marker = "DUMMY_PRIVATE_RPC_MARKER"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body := `{"jsonrpc":"2.0","id":1,"result":{"signed_header":{"header":{"height":{"private":"` + marker + `"}}}}}`
+		if strings.HasSuffix(r.URL.Path, "/evidence_history") {
+			body = `{"jsonrpc":"2.0","id":1,"result":{"header":{"height":{"private":"` + marker + `"}}}}`
+		}
+		_, _ = w.Write([]byte(body))
+	}))
+	defer server.Close()
+	provider, err := NewHistoryRPCProvider(server.URL, DefaultHistoryLimits())
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 3)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), marker)
+	closed := httptest.NewServer(http.NotFoundHandler())
+	closed.Close()
+	provider, err = NewHistoryRPCProvider(closed.URL+"/"+marker, DefaultHistoryLimits())
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 3)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), marker)
+	_, err = NewHistoryRPCProvider("http://dummy:"+marker+"@%zz", DefaultHistoryLimits())
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), marker)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = provider.Fetch(ctx, 3)
+	require.ErrorIs(t, err, context.Canceled)
+}
diff --git a/statesync/history_offer.go b/statesync/history_offer.go
new file mode 100644
index 0000000..fcdc895
--- /dev/null
+++ b/statesync/history_offer.go
@@ -0,0 +1,48 @@
+package statesync
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+
+	abci "github.com/cometbft/cometbft/abci/types"
+)
+
+type historyEcho interface {
+	Echo(context.Context, string) (*abci.ResponseEcho, error)
+}
+
+// Pair only the local ABCI Offer. The peer-visible snapshot identity and
+// advertised metadata remain untouched. A fresh nonce is consumed per offer.
+func historyOfferMetadata(ctx context.Context, query historyEcho, metadata []byte) ([]byte, error) {
+	if len(metadata) > snapshotMsgSize {
+		return nil, fmt.Errorf("snapshot metadata exceeds network limit")
+	}
+	var random [32]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil, fmt.Errorf("cannot generate local history pairing nonce: %w", err)
+	}
+	nonce := hex.EncodeToString(random[:])
+	ctx, cancel := context.WithTimeout(ctx, DefaultHistoryLimits().RequestTimeout)
+	defer cancel()
+	response, err := query.Echo(ctx, "xian-evidence-history/1:"+nonce)
+	if err != nil {
+		// The local server may quote its request in an error. Never propagate
+		// the per-offer private nonce into state-sync logs.
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, fmt.Errorf("local history-aware ABCI pairing failed")
+	}
+	if response == nil || response.Message != "xian-evidence-history/1:registered:"+nonce {
+		return nil, fmt.Errorf("history-aware ABCI pairing is required before snapshot restore")
+	}
+	return json.Marshal(struct {
+		SchemaVersion int    `json:"schema_version"`
+		Nonce         string `json:"xian_evidence_history_nonce"`
+		Metadata      string `json:"metadata"`
+	}{SchemaVersion: 1, Nonce: nonce, Metadata: base64.StdEncoding.EncodeToString(metadata)})
+}
