+func historyAdversarialLargeRecord(t *testing.T) (HistoryAnchor, HistoryRecord) {
+	t.Helper()
+	validators, signers := cmttest.ValidatorSet(context.Background(), t, 201, 10)
+	header := &types.Header{
+		Version: cmtversion.Consensus{Block: version.BlockProtocol},
+		ChainID: "history-pagination", Height: 1,
+		Time:           time.Date(2026, 1, 1, 0, 0, 0, 1, time.UTC),
+		ValidatorsHash: validators.Hash(), NextValidatorsHash: validators.Hash(),
+		ProposerAddress: validators.Validators[0].Address,
+	}
+	id := cmttest.MakeBlockIDWithHash(header.Hash())
+	commit, err := cmttest.MakeCommit(id, 1, 0, validators, signers, header.ChainID, header.Time)
+	require.NoError(t, err)
+	next := *header
+	next.Height = 2
+	next.Time = header.Time.Add(time.Nanosecond)
+	next.LastBlockID = id
+	next.LastCommitHash = commit.Hash()
+	return HistoryAnchor{Header: header, NextHeader: &next, InitialHeight: 1},
+		HistoryRecord{Header: header, Validators: validators, Commit: commit}
+}
+
+func historyAdversarialRPCBody(t *testing.T, result any) []byte {
+	t.Helper()
+	raw, err := cmtjson.Marshal(result)
+	require.NoError(t, err)
+	body, err := json.Marshal(struct {
+		JSONRPC string          `json:"jsonrpc"`
+		Result  json.RawMessage `json:"result"`
+	}{JSONRPC: "2.0", Result: raw})
+	require.NoError(t, err)
+	return body
+}
+
+type historyAdversarialRPC struct {
+	record HistoryRecord
+	alter  func(int, *coretypes.ResultValidators)
+	mu     sync.Mutex
+	pages  []int
+}
+
+func (s *historyAdversarialRPC) serve(t *testing.T, w http.ResponseWriter, r *http.Request) {
+	if r.URL.Query().Get("height") != strconv.FormatInt(s.record.Header.Height, 10) {
+		http.Error(w, "unexpected height", http.StatusBadRequest)
+		return
+	}
+	if r.URL.Path == "/rpc/commit" {
+		_, _ = w.Write(historyAdversarialRPCBody(t, coretypes.NewResultCommit(s.record.Header, s.record.Commit, true)))
+		return
+	}
+	if r.URL.Path == "/rpc/evidence_history" {
+		http.Error(w, "dedicated history unavailable", http.StatusNotFound)
+		return
+	}
+	page, err := strconv.Atoi(r.URL.Query().Get("page"))
+	if r.URL.Path != "/rpc/validators" || err != nil || page < 1 || r.URL.Query().Get("per_page") != "100" {
+		http.Error(w, "unexpected page request", http.StatusBadRequest)
+		return
+	}
+	s.mu.Lock()
+	s.pages = append(s.pages, page)
+	s.mu.Unlock()
+	response, ok := s.validatorPage(page)
+	if !ok {
+		http.Error(w, "unexpected extra page", http.StatusBadRequest)
+		return
+	}
+	_, _ = w.Write(historyAdversarialRPCBody(t, response))
+}
+
+func (s *historyAdversarialRPC) validatorPage(page int) (coretypes.ResultValidators, bool) {
+	first := (page - 1) * 100
+	last := min(first+100, len(s.record.Validators.Validators))
+	if first >= last {
+		return coretypes.ResultValidators{}, false
+	}
+	response := coretypes.ResultValidators{
+		BlockHeight: s.record.Header.Height,
+		Validators:  s.record.Validators.Validators[first:last],
+		Count:       last - first, Total: len(s.record.Validators.Validators),
+	}
+	if s.alter != nil {
+		s.alter(page, &response)
+	}
+	return response, true
+}
+
+func TestHistoryAdversarialHTTPPaginationAuthenticatesAllPages(t *testing.T) {
+	anchor, record := historyAdversarialLargeRecord(t)
+	rpc := &historyAdversarialRPC{record: record}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { rpc.serve(t, w, r) }))
+	defer server.Close()
+	provider, err := NewHistoryRPCProvider(server.URL+"/rpc", DefaultHistoryLimits())
+	require.NoError(t, err)
+	result, err := FetchHistory(context.Background(), anchor,
+		types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour},
+		[]HistoryProvider{provider}, DefaultHistoryLimits(), func(record HistoryRecord) error {
+			require.Len(t, record.Validators.Validators, 201)
+			require.Equal(t, []byte(anchor.Header.ValidatorsHash), record.Validators.Hash())
+			return nil
+		})
+	require.NoError(t, err)
+	require.Equal(t, int64(1), result.Count)
+	rpc.mu.Lock()
+	defer rpc.mu.Unlock()
+	require.Equal(t, []int{1, 2, 3}, rpc.pages)
+}
+
+func TestHistoryAdversarialHTTPRejectsInconsistentPages(t *testing.T) {
+	anchor, record := historyAdversarialLargeRecord(t)
+	mutations := map[string]func(*coretypes.ResultValidators){
+		"height": func(response *coretypes.ResultValidators) { response.BlockHeight++ },
+		"total":  func(response *coretypes.ResultValidators) { response.Total++ },
+		"count":  func(response *coretypes.ResultValidators) { response.Count-- },
+		"empty": func(response *coretypes.ResultValidators) {
+			response.Validators = nil
+			response.Count = 0
+		},
+		"repeated page": func(response *coretypes.ResultValidators) {
+			response.Validators = record.Validators.Validators[:100]
+		},
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			rpc := &historyAdversarialRPC{record: record, alter: func(page int, response *coretypes.ResultValidators) {
+				if page == 2 {
+					mutate(response)
+				}
+			}}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { rpc.serve(t, w, r) }))
+			defer server.Close()
+			provider, err := NewHistoryRPCProvider(server.URL+"/rpc", DefaultHistoryLimits())
+			require.NoError(t, err)
+			_, err = FetchHistory(context.Background(), anchor,
+				types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour},
+				[]HistoryProvider{provider}, DefaultHistoryLimits(), func(HistoryRecord) error {
+					t.Fatal("inconsistent validator pages were published")
+					return nil
+				})
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestHistoryAdversarialHTTPGzipCountsExpandedBytes(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Encoding", "gzip")
+		body := gzip.NewWriter(w)
+		_, _ = body.Write([]byte(strings.Repeat(" ", 4096)))
+		_ = body.Close()
+	}))
+	defer server.Close()
+	limits := DefaultHistoryLimits()
+	limits.MaxResponseBytes = 128
+	provider, err := NewHistoryRPCProvider(server.URL, limits)
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 1)
+	require.ErrorContains(t, err, "byte limit")
+}
+
+func TestHistoryAdversarialHTTPRecordBudgetIncludesEveryPage(t *testing.T) {
+	_, record := historyAdversarialLargeRecord(t)
+	commitBody := historyAdversarialRPCBody(t, coretypes.NewResultCommit(record.Header, record.Commit, true))
+	firstPage := historyAdversarialRPCBody(t, coretypes.ResultValidators{
+		BlockHeight: 1, Validators: record.Validators.Validators[:100], Count: 100, Total: 201,
+	})
+	limits := DefaultHistoryLimits()
+	limits.MaxResponseBytes = int64(len(commitBody) + len(firstPage) - 1)
+	require.Less(t, int64(len(commitBody)), limits.MaxResponseBytes)
+	require.Less(t, int64(len(firstPage)), limits.MaxResponseBytes)
+	rpc := &historyAdversarialRPC{record: record}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { rpc.serve(t, w, r) }))
+	defer server.Close()
+	provider, err := NewHistoryRPCProvider(server.URL+"/rpc", limits)
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 1)
+	require.ErrorContains(t, err, "byte limit")
+}
+
+func TestHistoryAdversarialHTTPDoesNotFollowRedirects(t *testing.T) {
+	var mu sync.Mutex
+	requests := 0
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		mu.Lock()
+		requests++
+		mu.Unlock()
+		_, _ = w.Write([]byte("unexpected redirect target"))
+	}))
+	defer target.Close()
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL, http.StatusFound)
+	}))
+	defer source.Close()
+	provider, err := NewHistoryRPCProvider(source.URL, DefaultHistoryLimits())
+	require.NoError(t, err)
+	_, err = provider.Fetch(context.Background(), 1)
+	require.ErrorContains(t, err, "status 302")
+	mu.Lock()
+	defer mu.Unlock()
+	require.Zero(t, requests)
+}
+
+func TestHistoryAdversarialSinkFailureStopsBeforeNextFetch(t *testing.T) {
+	anchor, records := historyTestChain(t, 3)
+	var requested []int64
+	provider := historyTestProvider(func(_ context.Context, height int64) (HistoryRecord, error) {
+		requested = append(requested, height)
+		return historyCopy(t, records[height]), nil
+	})
+	diskError := errors.New("history disk full")
+	result, err := FetchHistory(context.Background(), anchor,
+		types.EvidenceParams{MaxAgeNumBlocks: 8, MaxAgeDuration: time.Hour},
+		[]HistoryProvider{provider}, DefaultHistoryLimits(), func(HistoryRecord) error { return diskError })
+	require.ErrorIs(t, err, diskError)
+	require.Zero(t, result.Count)
+	require.Equal(t, []int64{3}, requested)
+}
diff --git a/statesync/history_fetch.go b/statesync/history_fetch.go
new file mode 100644
index 0000000..7f04cf7
--- /dev/null
+++ b/statesync/history_fetch.go
@@ -0,0 +1,508 @@
+package statesync
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	cryptoenc "github.com/cometbft/cometbft/crypto/encoding"
+	cmtjson "github.com/cometbft/cometbft/libs/json"
+	coretypes "github.com/cometbft/cometbft/rpc/core/types"
+	"github.com/cometbft/cometbft/types"
+)
+
+// HistoryRecord is evidence-only historical data, never current consensus state.
+type HistoryRecord struct {
+	Header     *types.Header       `json:"header"`
+	Validators *types.ValidatorSet `json:"validators"`
+	Commit     *types.Commit       `json:"commit"`
+}
+
+// HistoryAnchor must come from the existing light client's verified H/H+1.
+type HistoryAnchor struct {
+	Header        *types.Header
+	NextHeader    *types.Header
+	InitialHeight int64
+}
+
+type HistoryProvider interface {
+	// Fetch must honor context cancellation. Returned data is untrusted.
+	Fetch(context.Context, int64) (HistoryRecord, error)
+}
+
+type HistoryLimits struct {
+	MaxRecords       int64
+	MaxBytes         int64
+	MaxResponseBytes int64
+	MaxValidators    int
+	MaxProviders     int
+	RetryRounds      int
+	RequestTimeout   time.Duration
+}
+
+type HistoryResult struct {
+	LowestHeight int64
+	Count        int64
+	Bytes        int64
+}
+
+func DefaultHistoryLimits() HistoryLimits {
+	return HistoryLimits{MaxRecords: 1000000, MaxBytes: 2 << 30, MaxResponseBytes: 8 << 20, MaxValidators: 10000, MaxProviders: 8, RetryRounds: 2, RequestTimeout: 10 * time.Second}
+}
+
+func (l HistoryLimits) validate() error {
+	for _, bound := range []struct {
+		name           string
+		value, maximum int64
+	}{
+		{"records", l.MaxRecords, 10000000},
+		{"bytes", l.MaxBytes, 1 << 40},
+		{"response", l.MaxResponseBytes, 64 << 20},
+		{"validators", int64(l.MaxValidators), 10000},
+		{"providers", int64(l.MaxProviders), 16},
+		{"retries", int64(l.RetryRounds), 4},
+		{"timeout", int64(l.RequestTimeout), int64(time.Minute)},
+	} {
+		if bound.value <= 0 || bound.value > bound.maximum {
+			return fmt.Errorf("invalid history %s limit", bound.name)
+		}
+	}
+	return nil
+}
+
+type historyRPCProvider struct {
+	base   *url.URL
+	client *http.Client
+	limits HistoryLimits
+}
+
+// NewHistoryRPCProvider accepts operator-selected HTTP(S) endpoints only. Bodies
+// are bounded after transport decompression, redirects are refused, and one
+// connection and one request deadline bound the entire record fetch.
+func NewHistoryRPCProvider(server string, limits HistoryLimits) (HistoryProvider, error) {
+	if err := limits.validate(); err != nil {
+		return nil, err
+	}
+	u, err := historyRPCURL(server)
+	if err != nil {
+		return nil, err
+	}
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.MaxConnsPerHost = 1
+	transport.MaxIdleConnsPerHost = 1
+	transport.ResponseHeaderTimeout = limits.RequestTimeout
+	client := &http.Client{Transport: transport, Timeout: limits.RequestTimeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	return &historyRPCProvider{base: u, client: client, limits: limits}, nil
+}
+
+func historyRPCURL(server string) (*url.URL, error) {
+	if !strings.Contains(server, "://") {
+		server = "http://" + server
+	}
+	u, err := url.Parse(server)
+	if err != nil {
+		return nil, fmt.Errorf("history RPC URL syntax invalid")
+	}
+	if (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return nil, fmt.Errorf("history RPC requires an HTTP(S) URL without credentials/query/fragment")
+	}
+	return u, nil
+}
+
+func (p *historyRPCProvider) request(ctx context.Context, method string, query url.Values, result any, remaining *int64) error {
+	if *remaining <= 0 {
+		return fmt.Errorf("history RPC response byte limit exhausted")
+	}
+	u := *p.base
+	u.Path = strings.TrimRight(u.Path, "/") + "/" + method
+	u.RawQuery = query.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return historyRPCFailure(ctx, "request setup")
+	}
+	response, err := p.client.Do(req)
+	if err != nil {
+		return historyRPCFailure(ctx, "request")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("history RPC status %d", response.StatusCode)
+	}
+	available := *remaining
+	body, err := io.ReadAll(io.LimitReader(response.Body, available+1))
+	*remaining -= min(int64(len(body)), available)
+	if int64(len(body)) > available {
+		return fmt.Errorf("history RPC response exceeds byte limit")
+	}
+	if err != nil {
+		return historyRPCFailure(ctx, "response read")
+	}
+	return decodeHistoryRPC(body, result)
+}
+
+func decodeHistoryRPC(body []byte, result any) error {
+	var envelope struct {
+		JSONRPC string          `json:"jsonrpc"`
+		Result  json.RawMessage `json:"result"`
+		Error   json.RawMessage `json:"error"`
+	}
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return fmt.Errorf("history RPC response JSON invalid")
+	}
+	if envelope.JSONRPC != "2.0" || len(envelope.Result) == 0 || (len(envelope.Error) > 0 && string(envelope.Error) != "null") {
+		return fmt.Errorf("history RPC invalid/error response")
+	}
+	if err := cmtjson.Unmarshal(envelope.Result, result); err != nil {
+		return fmt.Errorf("history RPC result decode failed")
+	}
+	return nil
+}
+
+// Network/codec errors may quote raw responses or credential-bearing URL paths.
+// Keep cancellation semantics, while exposing only fixed diagnostic phases.
+func historyRPCFailure(ctx context.Context, phase string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return fmt.Errorf("history RPC %s failed", phase)
+}
+
+func (p *historyRPCProvider) Fetch(ctx context.Context, height int64) (HistoryRecord, error) {
+	ctx, cancel := context.WithTimeout(ctx, p.limits.RequestTimeout)
+	defer cancel()
+	if height <= 0 {
+		return HistoryRecord{}, fmt.Errorf("invalid history RPC height")
+	}
+	remaining := p.limits.MaxResponseBytes
+	record, err := p.standard(ctx, height, &remaining)
+	record, err = historyRPCResult(ctx, record, err)
+	if err == nil {
+		return record, nil
+	}
+	if contextErr := ctx.Err(); contextErr != nil {
+		return HistoryRecord{}, contextErr
+	}
+	if remaining <= 0 {
+		return HistoryRecord{}, fmt.Errorf("history RPC response byte limit exhausted")
+	}
+	query := url.Values{"height": []string{strconv.FormatInt(height, 10)}}
+	var dedicated HistoryRecord
+	err = p.request(ctx, "evidence_history", query, &dedicated, &remaining)
+	return historyRPCResult(ctx, dedicated, err)
+}
+
+func historyRPCResult(ctx context.Context, record HistoryRecord, err error) (HistoryRecord, error) {
+	if contextErr := ctx.Err(); contextErr != nil {
+		return HistoryRecord{}, contextErr
+	}
+	if err != nil {
+		return HistoryRecord{}, err
+	}
+	if record.Header == nil || record.Commit == nil || record.Validators == nil {
+		return HistoryRecord{}, fmt.Errorf("history RPC proof incomplete")
+	}
+	return record, nil
+}
+
+func (p *historyRPCProvider) standard(ctx context.Context, height int64, remaining *int64) (HistoryRecord, error) {
+	query := url.Values{"height": []string{strconv.FormatInt(height, 10)}}
+	var committed coretypes.ResultCommit
+	if err := p.request(ctx, "commit", query, &committed, remaining); err != nil {
+		return HistoryRecord{}, err
+	}
+	validators, err := p.validators(ctx, height, remaining)
+	if err != nil {
+		return HistoryRecord{}, err
+	}
+	return HistoryRecord{Header: committed.Header, Commit: committed.Commit, Validators: validators}, nil
+}
+
+func (p *historyRPCProvider) validators(ctx context.Context, height int64, remainingBytes *int64) (*types.ValidatorSet, error) {
+	const perPage = 100
+	var members []*types.Validator
+	total := -1
+	for page := 1; ; page++ {
+		query := url.Values{"height": []string{strconv.FormatInt(height, 10)}, "page": []string{strconv.Itoa(page)}, "per_page": []string{strconv.Itoa(perPage)}}
+		var response coretypes.ResultValidators
+		if err := p.request(ctx, "validators", query, &response, remainingBytes); err != nil {
+			return nil, err
+		}
+		if total < 0 {
+			total = response.Total
+		}
+		if err := validateHistoryPage(response, height, total, len(members), p.limits.MaxValidators); err != nil {
+			return nil, err
+		}
+		members = append(members, response.Validators...)
+		if len(members) == total {
+			return historyValidatorSet(members, p.limits.MaxValidators)
+		}
+	}
+}
+
+func validateHistoryPage(response coretypes.ResultValidators, height int64, total, collected, maximum int) error {
+	if response.BlockHeight != height || response.Total <= 0 || response.Total > maximum {
+		return fmt.Errorf("history RPC invalid validator height/total")
+	}
+	want := min(100, total-collected)
+	if response.Total != total || response.Count != len(response.Validators) || response.Count != want {
+		return fmt.Errorf("history RPC inconsistent validator page")
+	}
+	return nil
+}
+
+// RPC priorities/proposer are unauthenticated and irrelevant to evidence. Build
+// a new canonical historical copy, leaving every caller/current set untouched.
+func historyValidatorSet(members []*types.Validator, maximum int) (*types.ValidatorSet, error) {
+	if len(members) == 0 || len(members) > maximum {
+		return nil, fmt.Errorf("history validator count exceeds limit")
+	}
+	clean := make([]*types.Validator, 0, len(members))
+	seen := make(map[string]bool, len(members))
+	var power int64
+	for _, member := range members {
+		validator, err := historyValidator(member)
+		if err != nil {
+			return nil, err
+		}
+		if seen[string(validator.Address)] || validator.VotingPower > types.MaxTotalVotingPower-power {
+			return nil, fmt.Errorf("history duplicate validator or excessive total power")
+		}
+		seen[string(validator.Address)] = true
+		power += validator.VotingPower
+		clean = append(clean, validator)
+	}
+	return types.NewValidatorSet(clean), nil
+}
+
+func historyValidator(member *types.Validator) (*types.Validator, error) {
+	if member == nil || member.PubKey == nil || member.VotingPower <= 0 {
+		return nil, fmt.Errorf("history requires nonnil validators with positive power")
+	}
+	encoded, err := cryptoenc.PubKeyToProto(member.PubKey)
+	if err != nil {
+		return nil, err
+	}
+	key, err := cryptoenc.PubKeyFromProto(encoded)
+	if err != nil {
+		return nil, err
+	}
+	if !bytes.Equal(key.Address(), member.Address) {
+		return nil, fmt.Errorf("history validator address does not match public key")
+	}
+	return types.NewValidator(key, member.VotingPower), nil
+}
+
+func (a HistoryAnchor) validate() error {
+	if a.Header == nil || a.NextHeader == nil || a.InitialHeight <= 0 {
+		return fmt.Errorf("history requires light-verified H/H+1 and initial height")
+	}
+	if err := a.NextHeader.ValidateBasic(); err != nil {
+		return err
+	}
+	if a.Header.Height < a.InitialHeight || a.Header.Height == math.MaxInt64 {
+		return fmt.Errorf("history anchor height mismatch")
+	}
+	return validateHistoryHeader(a.Header, historyLinkFrom(a.NextHeader))
+}
+
+// A sink owns its emitted objects. Keep traversal authentication independent of
+// those mutable objects, including byte slices inside the previous BlockID.
+type historyLink struct {
+	Height         int64
+	ChainID        string
+	Time           time.Time
+	LastBlockID    types.BlockID
+	LastCommitHash []byte
+}
+
+func historyLinkFrom(header *types.Header) historyLink {
+	id := header.LastBlockID
+	id.Hash = bytes.Clone(id.Hash)
+	id.PartSetHeader.Hash = bytes.Clone(id.PartSetHeader.Hash)
+	return historyLink{header.Height, header.ChainID, header.Time, id, bytes.Clone(header.LastCommitHash)}
+}
+
+func authenticateHistory(record HistoryRecord, next historyLink, maximum int) (HistoryRecord, error) {
+	if record.Header == nil || record.Validators == nil || record.Commit == nil {
+		return HistoryRecord{}, fmt.Errorf("incomplete history record")
+	}
+	if err := validateHistoryHeader(record.Header, next); err != nil {
+		return HistoryRecord{}, err
+	}
+	if err := validateHistoryCommit(record.Commit, record.Header.Height, next); err != nil {
+		return HistoryRecord{}, err
+	}
+	validators, err := historyValidatorSet(record.Validators.Validators, maximum)
+	if err != nil {
+		return HistoryRecord{}, err
+	}
+	if !bytes.Equal(validators.Hash(), record.Header.ValidatorsHash) {
+		return HistoryRecord{}, fmt.Errorf("history validator hash mismatch")
+	}
+	if err := validators.VerifyCommitLightAllSignatures(record.Header.ChainID, next.LastBlockID, record.Header.Height, record.Commit); err != nil {
+		return HistoryRecord{}, err
+	}
+	record.Validators = validators
+	return record, nil
+}
+
+func validateHistoryHeader(header *types.Header, next historyLink) error {
+	if err := header.ValidateBasic(); err != nil {
+		return err
+	}
+	if header.Height != next.Height-1 || header.ChainID == "" || header.ChainID != next.ChainID || !header.Time.Before(next.Time) {
+		return fmt.Errorf("history header chain/height/time mismatch")
+	}
+	if !bytes.Equal(header.Hash(), next.LastBlockID.Hash) {
+		return fmt.Errorf("history header hash mismatch")
+	}
+	return nil
+}
+
+func validateHistoryCommit(commit *types.Commit, height int64, next historyLink) error {
+	if err := commit.ValidateBasic(); err != nil {
+		return err
+	}
+	if commit.Height != height || !commit.BlockID.Equals(next.LastBlockID) || !bytes.Equal(commit.Hash(), next.LastCommitHash) {
+		return fmt.Errorf("history canonical commit mismatch")
+	}
+	return nil
+}
+
+func fetchHistoryRecord(ctx context.Context, height int64, next historyLink, providers []HistoryProvider, limits HistoryLimits) (HistoryRecord, error) {
+	var last error
+	for round := 0; round < limits.RetryRounds; round++ {
+		for _, provider := range providers {
+			if err := ctx.Err(); err != nil {
+				return HistoryRecord{}, err
+			}
+			requestCtx, cancel := context.WithTimeout(ctx, limits.RequestTimeout)
+			record, err := provider.Fetch(requestCtx, height)
+			cancel()
+			if err == nil {
+				record, err = authenticateHistory(record, next, limits.MaxValidators)
+			}
+			if err == nil {
+				return record, nil
+			}
+			last = err
+		}
+	}
+	return HistoryRecord{}, fmt.Errorf("cannot authenticate history height %d: %w", height, last)
+}
+
+// Budget canonical payload bytes, charging repeated validator sets only once,
+// as the evidence cache does. Its binary encoding is smaller than this JSON.
+func historyRecordBytes(record HistoryRecord, seen map[string]bool) (int64, error) {
+	body := struct {
+		Header *types.Header `json:"header"`
+		Commit *types.Commit `json:"commit"`
+	}{record.Header, record.Commit}
+	encoded, err := cmtjson.Marshal(body)
+	if err != nil {
+		return 0, err
+	}
+	count := int64(len(encoded))
+	if !seen[string(record.Header.ValidatorsHash)] {
+		validators, err := cmtjson.Marshal(record.Validators)
+		if err != nil {
+			return 0, err
+		}
+		count += int64(len(validators))
+	}
+	return count, nil
+}
+
+func validateHistoryInputs(anchor HistoryAnchor, params types.EvidenceParams, providers []HistoryProvider, limits HistoryLimits, emit func(HistoryRecord) error) error {
+	if err := limits.validate(); err != nil {
+		return err
+	}
+	if err := anchor.validate(); err != nil {
+		return err
+	}
+	if params.MaxAgeNumBlocks <= 0 || params.MaxAgeDuration <= 0 || params.MaxBytes < 0 {
+		return fmt.Errorf("invalid history evidence policy")
+	}
+	return validateHistoryProviders(providers, limits.MaxProviders, emit)
+}
+
+func validateHistoryProviders(providers []HistoryProvider, maximum int, emit func(HistoryRecord) error) error {
+	if emit == nil || len(providers) == 0 || len(providers) > maximum {
+		return fmt.Errorf("invalid history providers/callback")
+	}
+	for _, provider := range providers {
+		if provider == nil {
+			return fmt.Errorf("nil history provider")
+		}
+	}
+	return nil
+}
+
+type historyRetention struct {
+	limits     HistoryLimits
+	result     HistoryResult
+	validators map[string]bool
+}
+
+func (r *historyRetention) retain(ctx context.Context, record HistoryRecord, emit func(HistoryRecord) error) error {
+	encodedBytes, err := historyRecordBytes(record, r.validators)
+	if err != nil {
+		return err
+	}
+	if r.result.Count >= r.limits.MaxRecords || encodedBytes > r.limits.MaxBytes-r.result.Bytes {
+		return fmt.Errorf("history retained record/byte limit exceeded")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	validatorHash := string(record.Header.ValidatorsHash)
+	height := record.Header.Height
+	if err := emit(record); err != nil {
+		return err
+	}
+	r.result.LowestHeight, r.result.Count, r.result.Bytes = height, r.result.Count+1, r.result.Bytes+encodedBytes
+	r.validators[validatorHash] = true
+	return nil
+}
+
+func historyExpired(height, checkpoint, maxAge int64, timestamp, cutoff time.Time) bool {
+	return height < checkpoint-maxAge && timestamp.Before(cutoff)
+}
+
+// FetchHistory streams only authenticated records. Evidence params MUST already
+// be authenticated by restored application state: ConsensusParams.Hash does not
+// authenticate evidence fields. emit must durably stage records idempotently;
+// callers may mark the staging cache ready only on a nil final error.
+func FetchHistory(ctx context.Context, anchor HistoryAnchor, params types.EvidenceParams, providers []HistoryProvider, limits HistoryLimits, emit func(HistoryRecord) error) (HistoryResult, error) {
+	retained := historyRetention{limits: limits, validators: make(map[string]bool)}
+	if err := validateHistoryInputs(anchor, params, providers, limits, emit); err != nil {
+		return retained.result, err
+	}
+	next := historyLinkFrom(anchor.NextHeader)
+	checkpointHeight := anchor.Header.Height
+	cutoffTime := anchor.Header.Time.Add(-params.MaxAgeDuration)
+	for height := checkpointHeight; height >= anchor.InitialHeight; height-- {
+		record, err := fetchHistoryRecord(ctx, height, next, providers, limits)
+		if err != nil {
+			return retained.result, err
+		}
+		if historyExpired(height, checkpointHeight, params.MaxAgeNumBlocks, record.Header.Time, cutoffTime) {
+			return retained.result, nil
+		}
+		nextLink := historyLinkFrom(record.Header)
+		if err := retained.retain(ctx, record, emit); err != nil {
+			return retained.result, err
+		}
+		next = nextLink
+	}
+	return retained.result, nil
+}
