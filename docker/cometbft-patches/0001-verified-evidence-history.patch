+
+func historyBackwardChain(t *testing.T) ([]*types.Header, []*types.Commit, *types.ValidatorSet, *types.GenesisDoc, historyQueryStub) {
+	t.Helper()
+	vals, private := types.RandValidatorSet(1, 10)
+	params := types.DefaultConsensusParams()
+	headers, commits := make([]*types.Header, 4), make([]*types.Commit, 4)
+	start := time.Now().UTC().Add(-10 * time.Second)
+	var previous types.BlockID
+	for height := int64(1); height <= 3; height++ {
+		header := &types.Header{Version: cmtversion.Consensus{Block: version.BlockProtocol, App: 7}, ChainID: "backward-checkpoint", Height: height, Time: start.Add(time.Duration(height) * time.Second), LastBlockID: previous, ValidatorsHash: vals.Hash(), NextValidatorsHash: vals.Hash(), ProposerAddress: vals.Validators[0].Address, ConsensusHash: params.Hash(), AppHash: bytes.Repeat([]byte{2}, 32)}
+		if height > 1 {
+			header.LastCommitHash = commits[height-1].Hash()
+		}
+		id := cmttest.MakeBlockIDWithHash(header.Hash())
+		commit, err := cmttest.MakeCommit(id, height, 0, vals, private, header.ChainID, header.Time)
+		require.NoError(t, err)
+		headers[height], commits[height], previous = header, commit, id
+	}
+	body, err := json.Marshal(map[string]any{"schema_version": 1, "height": "1", "app_hash": hex.EncodeToString(headers[2].AppHash), "last_block_nanos": exactHistoryNanos(headers[1].Time), "evidence": map[string]string{"max_age_num_blocks": "100000", "max_age_duration": "1296000000000000", "max_bytes": "1048576"}})
+	require.NoError(t, err)
+	query := historyQueryStub{info: &abci.ResponseInfo{LastBlockHeight: 1, LastBlockAppHash: headers[2].AppHash, AppVersion: 7}, query: &abci.ResponseQuery{Height: 1, Value: body}}
+	return headers, commits, vals, &types.GenesisDoc{ChainID: headers[1].ChainID, InitialHeight: 1, ConsensusParams: params}, query
+}
+
+func historyBackwardRPC(t *testing.T, headers []*types.Header, commits []*types.Commit, vals *types.ValidatorSet, params *types.ConsensusParams, alteration string) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		method := strings.TrimPrefix(r.URL.Path, "/")
+		heightText := r.URL.Query().Get("height")
+		var id json.RawMessage = json.RawMessage(`-1`)
+		if r.Method == http.MethodPost {
+			var request struct {
+				ID     json.RawMessage            `json:"id"`
+				Method string                     `json:"method"`
+				Params map[string]json.RawMessage `json:"params"`
+			}
+			if json.NewDecoder(r.Body).Decode(&request) != nil {
+				http.Error(w, "invalid request", 400)
+				return
+			}
+			method, id = request.Method, request.ID
+			_ = json.Unmarshal(request.Params["height"], &heightText)
+		}
+		height, _ := strconv.Atoi(heightText)
+		if height == 0 {
+			height = 3
+		}
+		if height < 1 || height > 3 {
+			http.Error(w, "unavailable height", 400)
+			return
+		}
+		var result any
+		switch method {
+		case "commit":
+			commit := commits[height].Clone()
+			if height == 1 {
+				if alteration == "round" {
+					commit.Round++
+				}
+				if alteration == "blockid" {
+					commit.BlockID.PartSetHeader.Total++
+				}
+			}
+			result = coretypes.NewResultCommit(headers[height], commit, true)
+		case "validators":
+			result = &coretypes.ResultValidators{BlockHeight: int64(height), Validators: vals.Validators, Count: 1, Total: 1}
+		case "consensus_params":
+			result = &coretypes.ResultConsensusParams{BlockHeight: int64(height), ConsensusParams: *params}
+		default:
+			http.NotFound(w, r)
+			return
+		}
+		encoded, err := cmtjson.Marshal(result)
+		if err != nil {
+			http.Error(w, "encode failure", 500)
+			return
+		}
+		body, err := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": id, "result": json.RawMessage(encoded)})
+		if err != nil {
+			http.Error(w, "envelope failure", 500)
+			return
+		}
+		_, _ = w.Write(body)
+	}))
+}
+
+func TestHistoryBackwardLightCheckpointUsesCanonicalCoreCommit(t *testing.T) {
+	for _, kind := range []string{"round", "blockid"} {
+		t.Run(kind, func(t *testing.T) {
+			headers, commits, vals, genesis, query := historyBackwardChain(t)
+			primary := historyBackwardRPC(t, headers, commits, vals, genesis.ConsensusParams, kind)
+			defer primary.Close()
+			witness := historyBackwardRPC(t, headers, commits, vals, genesis.ConsensusParams, "")
+			defer witness.Close()
+			config := cfg.DefaultConfig()
+			config.StateSync.RPCServers = []string{primary.URL, witness.URL}
+			config.StateSync.TrustHeight = 3
+			config.StateSync.TrustHash = hex.EncodeToString(headers[3].Hash())
+			config.StateSync.TrustPeriod = time.Hour
+			db := dbm.NewMemDB()
+			require.NoError(t, writeHistoryPending(db, genesis.ChainID, 0))
+			stateStore := sm.NewStore(db, sm.StoreOptions{})
+			blocks := store.NewBlockStore(dbm.NewMemDB())
+			cache := evidence.NewHistoryCache(dbm.NewMemDB())
+			old := sm.State{ChainID: genesis.ChainID, InitialHeight: 1}
+			resumed, err := resumeEvidenceHistory(context.Background(), config, db, stateStore, blocks, cache, old, genesis, query, log.NewNopLogger())
+			if kind == "blockid" {
+				require.Error(t, err, "full checkpoint BlockID must match its authenticated successor")
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, int64(1), resumed.LastBlockHeight)
+			seen := blocks.LoadSeenCommit(1)
+			require.Equal(t, commits[1].Round, seen.Round, "core must use the canonical authenticated history commit, not the backwards light RPC commit")
+			require.NotPanics(t, func() { seen.ToVoteSet(genesis.ChainID, vals) })
+		})
+	}
+}
diff --git a/node/history_bootstrap.go b/node/history_bootstrap.go
new file mode 100644
index 0000000..a137bc8
--- /dev/null
+++ b/node/history_bootstrap.go
@@ -0,0 +1,498 @@
+package node
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math/big"
+	"strconv"
+	"sync"
+	"time"
+
+	dbm "github.com/cometbft/cometbft-db"
+	abci "github.com/cometbft/cometbft/abci/types"
+	cfg "github.com/cometbft/cometbft/config"
+	"github.com/cometbft/cometbft/evidence"
+	"github.com/cometbft/cometbft/libs/log"
+	"github.com/cometbft/cometbft/light"
+	sm "github.com/cometbft/cometbft/state"
+	"github.com/cometbft/cometbft/statesync"
+	"github.com/cometbft/cometbft/store"
+	"github.com/cometbft/cometbft/types"
+)
+
+type historyQuery interface {
+	Info(context.Context, *abci.RequestInfo) (*abci.ResponseInfo, error)
+	Query(context.Context, *abci.RequestQuery) (*abci.ResponseQuery, error)
+}
+
+type historyPolicyResponse struct {
+	SchemaVersion  int    `json:"schema_version"`
+	Height         string `json:"height"`
+	AppHash        string `json:"app_hash"`
+	LastBlockNanos string `json:"last_block_nanos"`
+	Evidence       struct {
+		MaxAgeNumBlocks string `json:"max_age_num_blocks"`
+		MaxAgeDuration  string `json:"max_age_duration"`
+		MaxBytes        string `json:"max_bytes"`
+	} `json:"evidence"`
+}
+
+// Timestamp anchors span protobuf's full calendar domain, beyond UnixNano's
+// int64 nanosecond limit. Duration fields have a separate signed-int64 domain.
+func exactHistoryNanos(t time.Time) string {
+	nanos := new(big.Int).Mul(big.NewInt(t.Unix()), big.NewInt(1_000_000_000))
+	return nanos.Add(nanos, big.NewInt(int64(t.Nanosecond()))).String()
+}
+
+func historyDecimal(value string, minimum int64) (int64, error) {
+	number, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || number < minimum || strconv.FormatInt(number, 10) != value {
+		return 0, fmt.Errorf("noncanonical history policy integer %q", value)
+	}
+	return number, nil
+}
+
+func decodeHistoryPolicy(data []byte) (historyPolicyResponse, error) {
+	var result historyPolicyResponse
+	if len(data) == 0 || len(data) > 8192 {
+		return result, fmt.Errorf("invalid evidence policy response size")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&result); err != nil {
+		return result, fmt.Errorf("invalid evidence policy schema: %w", err)
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return result, fmt.Errorf("trailing evidence policy data")
+	}
+	if result.SchemaVersion != 1 {
+		return result, fmt.Errorf("unsupported evidence policy schema")
+	}
+	return result, nil
+}
+
+func historyPolicyBinding(body historyPolicyResponse, state sm.State, anchor statesync.HistoryAnchor) error {
+	if body.Height != strconv.FormatInt(state.LastBlockHeight, 10) || body.AppHash != hex.EncodeToString(state.AppHash) || body.LastBlockNanos != exactHistoryNanos(anchor.Header.Time) {
+		return fmt.Errorf("committed evidence policy disagrees with trusted snapshot height/hash/time")
+	}
+	return nil
+}
+
+func historyEvidenceParams(body historyPolicyResponse) (types.EvidenceParams, error) {
+	blocks, err := historyDecimal(body.Evidence.MaxAgeNumBlocks, 1)
+	if err != nil {
+		return types.EvidenceParams{}, err
+	}
+	duration, err := historyDecimal(body.Evidence.MaxAgeDuration, 1)
+	if err != nil {
+		return types.EvidenceParams{}, err
+	}
+	maximum, err := historyDecimal(body.Evidence.MaxBytes, 0)
+	if err != nil {
+		return types.EvidenceParams{}, err
+	}
+	return types.EvidenceParams{MaxAgeNumBlocks: blocks, MaxAgeDuration: time.Duration(duration), MaxBytes: maximum}, nil
+}
+
+func validateHistoryCheckpoint(state sm.State, header *types.Header) error {
+	if header.Height != state.LastBlockHeight || header.ChainID != state.ChainID || !bytes.Equal(header.Hash(), state.LastBlockID.Hash) || !header.Time.Equal(state.LastBlockTime) {
+		return fmt.Errorf("history checkpoint disagrees with trusted state")
+	}
+	return nil
+}
+func validateHistorySuccessor(state sm.State, anchor statesync.HistoryAnchor) error {
+	next := anchor.NextHeader
+	if next.Height != state.LastBlockHeight+1 || next.ChainID != state.ChainID || !bytes.Equal(next.AppHash, state.AppHash) || !next.LastBlockID.Equals(state.LastBlockID) {
+		return fmt.Errorf("history next-header disagrees with trusted state")
+	}
+	return nil
+}
+func validateHistoryAnchorState(state sm.State, anchor statesync.HistoryAnchor) error {
+	if anchor.Header == nil || anchor.NextHeader == nil {
+		return fmt.Errorf("missing verified history anchor")
+	}
+	if err := validateHistoryCheckpoint(state, anchor.Header); err != nil {
+		return err
+	}
+	return validateHistorySuccessor(state, anchor)
+}
+
+// Only Block.MaxBytes/MaxGas are authenticated by Comet ConsensusHash. The
+// remaining groups must never be accepted from an unauthenticated RPC response.
+// Xian changes only Evidence; the local committed app supplies that triple.
+func validateHistoryAppInfo(info *abci.ResponseInfo, state sm.State, anchor statesync.HistoryAnchor) error {
+	if info == nil || info.LastBlockHeight != state.LastBlockHeight || !bytes.Equal(info.LastBlockAppHash, state.AppHash) || info.AppVersion != anchor.NextHeader.Version.App {
+		return fmt.Errorf("local app Info disagrees with trusted snapshot")
+	}
+	return nil
+}
+func committedHistoryPolicy(ctx context.Context, query historyQuery, state sm.State, anchor statesync.HistoryAnchor) (historyPolicyResponse, error) {
+	var empty historyPolicyResponse
+	info, err := query.Info(ctx, &abci.RequestInfo{})
+	if err != nil {
+		return empty, err
+	}
+	if err = validateHistoryAppInfo(info, state, anchor); err != nil {
+		return empty, err
+	}
+	response, err := query.Query(ctx, &abci.RequestQuery{Path: "/evidence_policy", Height: state.LastBlockHeight})
+	if err != nil {
+		return empty, err
+	}
+	if response == nil || response.Code != 0 || response.Height != state.LastBlockHeight {
+		return empty, fmt.Errorf("local committed evidence policy query failed")
+	}
+	body, err := decodeHistoryPolicy(response.Value)
+	if err != nil {
+		return empty, err
+	}
+	return body, historyPolicyBinding(body, state, anchor)
+}
+func authenticatedHistoryParams(ctx context.Context, query historyQuery, state sm.State, anchor statesync.HistoryAnchor, genesis types.ConsensusParams) (types.ConsensusParams, error) {
+	if err := validateHistoryAnchorState(state, anchor); err != nil {
+		return types.ConsensusParams{}, err
+	}
+	body, err := committedHistoryPolicy(ctx, query, state, anchor)
+	if err != nil {
+		return types.ConsensusParams{}, err
+	}
+	params := genesis
+	params.Validator.PubKeyTypes = append([]string(nil), genesis.Validator.PubKeyTypes...)
+	params.Block = state.ConsensusParams.Block
+	params.Version.App = anchor.NextHeader.Version.App
+	params.Evidence, err = historyEvidenceParams(body)
+	if err != nil {
+		return types.ConsensusParams{}, err
+	}
+	if !bytes.Equal(params.Hash(), anchor.NextHeader.ConsensusHash) {
+		return types.ConsensusParams{}, fmt.Errorf("block parameters disagree with trusted consensus hash")
+	}
+	if err = params.ValidateBasic(); err != nil {
+		return types.ConsensusParams{}, err
+	}
+	return params, nil
+}
+
+var historyRequiredKey = []byte("xian:evidence-history-required:v1")
+
+type historyRequirement struct {
+	Version    int    `json:"version"`
+	Pending    bool   `json:"pending"`
+	ChainID    string `json:"chain_id"`
+	Checkpoint int64  `json:"checkpoint"`
+	Digest     []byte `json:"digest"`
+}
+type historyCacheValidator interface{ Validate([]byte) error }
+
+func (r historyRequirement) validate() error {
+	if r.Version != 1 || r.ChainID == "" || r.Checkpoint < 0 {
+		return fmt.Errorf("invalid evidence history requirement")
+	}
+	if !r.Pending && (r.Checkpoint == 0 || len(r.Digest) != 32) {
+		return fmt.Errorf("invalid ready history requirement")
+	}
+	return nil
+}
+func readHistoryRequirement(db dbm.DB) (*historyRequirement, error) {
+	data, err := db.Get(historyRequiredKey)
+	if err != nil || len(data) == 0 {
+		return nil, err
+	}
+	var requirement historyRequirement
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&requirement); err != nil {
+		return nil, fmt.Errorf("corrupt history requirement: %w", err)
+	}
+	if err = decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("trailing history journal data")
+	}
+	if err = requirement.validate(); err != nil {
+		return nil, err
+	}
+	return &requirement, nil
+}
+
+func writeHistoryPending(db dbm.DB, chainID string, checkpoint int64) error {
+	data, err := json.Marshal(historyRequirement{Version: 1, Pending: true, ChainID: chainID, Checkpoint: checkpoint})
+	if err != nil {
+		return err
+	}
+	return db.SetSync(historyRequiredKey, data)
+}
+func writeHistoryReady(db dbm.DB, chainID string, checkpoint int64, digest []byte) error {
+	if checkpoint < 1 || len(digest) != 32 {
+		return fmt.Errorf("invalid history publication")
+	}
+	data, err := json.Marshal(historyRequirement{Version: 1, ChainID: chainID, Checkpoint: checkpoint, Digest: digest})
+	if err != nil {
+		return err
+	}
+	return db.SetSync(historyRequiredKey, data)
+}
+func validateHistoryRequirement(db dbm.DB, cache historyCacheValidator, state sm.State, canRetry bool) error {
+	requirement, err := readHistoryRequirement(db)
+	if err != nil || requirement == nil {
+		return err
+	}
+	if requirement.ChainID != state.ChainID {
+		return fmt.Errorf("evidence history requirement chain mismatch")
+	}
+	if requirement.Pending {
+		if state.LastBlockHeight == 0 && canRetry {
+			return nil
+		}
+		return fmt.Errorf("evidence history bootstrap remains incomplete")
+	}
+	if state.LastBlockHeight < requirement.Checkpoint && !canRetry {
+		return fmt.Errorf("history checkpoint exceeds local state")
+	}
+	return cache.Validate(requirement.Digest)
+}
+
+type historyAnchorProvider interface {
+	EvidenceHistoryAnchor(context.Context, uint64) (statesync.HistoryAnchor, error)
+}
+
+func historyLimits(config *cfg.Config) statesync.HistoryLimits {
+	limits := statesync.DefaultHistoryLimits()
+	if config.StateSync.HistoryMaxRecords > 0 {
+		limits.MaxRecords = config.StateSync.HistoryMaxRecords
+	}
+	if config.StateSync.HistoryMaxBytes > 0 {
+		limits.MaxBytes = config.StateSync.HistoryMaxBytes
+	}
+	return limits
+}
+
+// The ready checkpoint is the durable bootstrap floor while there are no full
+// blocks. The upstream offline-height scratch key is reset during startup and
+// cannot be its authority across repeated interrupted restarts.
+func loadHistoryBlocksyncHeight(db dbm.DB, blocks *store.BlockStore, state sm.State) (int64, error) {
+	if blocks.Height() != 0 || state.LastBlockHeight == 0 {
+		return 0, nil
+	}
+	requirement, err := readHistoryRequirement(db)
+	if err != nil {
+		return 0, err
+	}
+	if requirement == nil || requirement.Pending || requirement.Checkpoint != state.LastBlockHeight {
+		return 0, fmt.Errorf("restored core state lacks a matching ready evidence history checkpoint")
+	}
+	return requirement.Checkpoint, nil
+}
+
+func historyProviders(config *cfg.Config, limits statesync.HistoryLimits) ([]statesync.HistoryProvider, error) {
+	providers := make([]statesync.HistoryProvider, 0, len(config.StateSync.RPCServers))
+	for _, server := range config.StateSync.RPCServers {
+		provider, err := statesync.NewHistoryRPCProvider(server, limits)
+		if err != nil {
+			return nil, err
+		}
+		providers = append(providers, provider)
+	}
+	return providers, nil
+}
+
+func prepareEvidenceHistory(ctx context.Context, config *cfg.Config, state sm.State, genesis *types.GenesisDoc, provider statesync.StateProvider, query historyQuery, cache *evidence.HistoryCache) (sm.State, []byte, error) {
+	verified, ok := provider.(historyAnchorProvider)
+	if !ok {
+		return state, nil, fmt.Errorf("state provider cannot supply verified evidence history anchors")
+	}
+	anchor, err := verified.EvidenceHistoryAnchor(ctx, uint64(state.LastBlockHeight))
+	if err != nil {
+		return state, nil, err
+	}
+	if genesis.ConsensusParams == nil {
+		return state, nil, fmt.Errorf("missing trusted genesis consensus parameters")
+	}
+	state.ConsensusParams, err = authenticatedHistoryParams(ctx, query, state, anchor, *genesis.ConsensusParams)
+	if err != nil {
+		return state, nil, err
+	}
+	limits := historyLimits(config)
+	providers, err := historyProviders(config, limits)
+	if err != nil {
+		return state, nil, err
+	}
+	if err = cache.Begin(anchor.Header, anchor.NextHeader, anchor.InitialHeight); err != nil {
+		return state, nil, err
+	}
+	result, err := statesync.FetchHistory(ctx, anchor, state.ConsensusParams.Evidence, providers, limits, func(record statesync.HistoryRecord) error {
+		return cache.Put(record.Header, record.Validators, record.Commit)
+	})
+	if err != nil {
+		return state, nil, err
+	}
+	digest, err := cache.Complete(result.LowestHeight, result.Count)
+	return state, digest, err
+}
+
+func newHistoryStateProvider(ctx context.Context, config *cfg.Config, state sm.State, logger log.Logger) (statesync.StateProvider, error) {
+	bounded, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	return statesync.NewLightClientStateProvider(bounded, state.ChainID, state.Version, state.InitialHeight, config.StateSync.RPCServers, light.TrustOptions{Period: config.StateSync.TrustPeriod, Height: config.StateSync.TrustHeight, Hash: config.StateSync.TrustHashBytes()}, logger.With("module", "light"))
+}
+
+// Offline bootstrap and an online crash after core publication are resumed
+// before handshake, even when the operator toggled StateSync.Enable off.
+func resumeEvidenceHistory(ctx context.Context, config *cfg.Config, db dbm.DB, stateStore sm.Store, blocks *store.BlockStore, cache *evidence.HistoryCache, state sm.State, genesis *types.GenesisDoc, query historyQuery, logger log.Logger) (sm.State, error) {
+	return resumeEvidenceHistoryUsing(ctx, db, stateStore, blocks, state, query, func(ctx context.Context, height int64) (sm.State, []byte, *types.Commit, error) {
+		provider, err := newHistoryStateProvider(ctx, config, state, logger)
+		if err != nil {
+			return state, nil, nil, err
+		}
+		trusted, err := provider.State(ctx, uint64(height))
+		if err != nil {
+			return state, nil, nil, err
+		}
+		trusted, digest, err := prepareEvidenceHistory(ctx, config, trusted, genesis, provider, query, cache)
+		if err != nil {
+			return state, nil, nil, err
+		}
+		// A backwards light-client lookup authenticates the header, not all
+		// metadata of the RPC's associated commit. The cache's canonical commit
+		// is bound to H+1, including full BlockID and verified signatures.
+		commit, err := cache.Commit(height)
+		return trusted, digest, commit, err
+	})
+}
+
+type historyResumeBootstrap func(context.Context, int64) (sm.State, []byte, *types.Commit, error)
+
+func validateResumeAppHeight(info *abci.ResponseInfo, state sm.State, requirement *historyRequirement) error {
+	if state.LastBlockHeight > 0 && info.LastBlockHeight != state.LastBlockHeight {
+		return fmt.Errorf("app/core checkpoint mismatch during history resume")
+	}
+	if requirement.Checkpoint > 0 && info.LastBlockHeight != requirement.Checkpoint {
+		return fmt.Errorf("app/journal checkpoint mismatch during history resume")
+	}
+	return nil
+}
+func resumeHistoryInfo(ctx context.Context, query historyQuery, state sm.State, requirement *historyRequirement) (*abci.ResponseInfo, error) {
+	info, err := query.Info(ctx, &abci.RequestInfo{})
+	if err != nil {
+		return nil, err
+	}
+	if info == nil || info.LastBlockHeight < 0 {
+		return nil, fmt.Errorf("invalid local app height during history resume")
+	}
+	if err = validateResumeAppHeight(info, state, requirement); err != nil {
+		return nil, err
+	}
+	if info.LastBlockHeight > 0 && len(info.LastBlockAppHash) != 32 {
+		return nil, fmt.Errorf("invalid restored app hash during history resume")
+	}
+	return info, nil
+}
+
+func resumeHistoryBinding(old, trusted sm.State, info *abci.ResponseInfo) error {
+	if trusted.LastBlockHeight != info.LastBlockHeight || trusted.ChainID != old.ChainID || !bytes.Equal(trusted.AppHash, info.LastBlockAppHash) {
+		return fmt.Errorf("resumed light checkpoint disagrees with restored app")
+	}
+	if old.LastBlockHeight > 0 && (!trusted.LastBlockID.Equals(old.LastBlockID) || !bytes.Equal(trusted.AppHash, old.AppHash)) {
+		return fmt.Errorf("resumed history differs from committed core state")
+	}
+	return nil
+}
+
+func pendingHistoryRequirement(db dbm.DB, state sm.State) (*historyRequirement, error) {
+	requirement, err := readHistoryRequirement(db)
+	if err != nil {
+		return nil, err
+	}
+	if requirement == nil || !requirement.Pending {
+		return nil, nil
+	}
+	if requirement.ChainID != state.ChainID {
+		return nil, fmt.Errorf("pending history chain mismatch")
+	}
+	return requirement, nil
+}
+func publishHistoryCheckpoint(db dbm.DB, stateStore sm.Store, blocks *store.BlockStore, state sm.State, digest []byte, commit *types.Commit) error {
+	if err := stateStore.Bootstrap(state); err != nil {
+		return err
+	}
+	if err := blocks.SaveSeenCommit(state.LastBlockHeight, commit); err != nil {
+		return err
+	}
+	return writeHistoryReady(db, state.ChainID, state.LastBlockHeight, digest)
+}
+func resumeEvidenceHistoryUsing(ctx context.Context, db dbm.DB, stateStore sm.Store, blocks *store.BlockStore, state sm.State, query historyQuery, bootstrap historyResumeBootstrap) (sm.State, error) {
+	requirement, err := pendingHistoryRequirement(db, state)
+	if err != nil {
+		return state, err
+	}
+	if requirement == nil {
+		return state, nil
+	}
+	info, err := resumeHistoryInfo(ctx, query, state, requirement)
+	if err != nil {
+		return state, err
+	}
+	if info.LastBlockHeight == 0 {
+		return state, nil
+	}
+	trusted, digest, commit, err := bootstrap(ctx, info.LastBlockHeight)
+	if err != nil {
+		return state, err
+	}
+	if err = resumeHistoryBinding(state, trusted, info); err != nil {
+		return state, err
+	}
+	if err = publishHistoryCheckpoint(db, stateStore, blocks, trusted, digest, commit); err != nil {
+		return state, err
+	}
+	return trusted, nil
+}
+
+type historyWork struct {
+	mu       sync.Mutex
+	stopping bool
+	ctx      context.Context
+	cancel   context.CancelFunc
+	workers  sync.WaitGroup
+}
+
+// The returned finish function must run once. The gate serializes Add with
+// shutdown's Wait; a late legacy snapshot completion cannot publish into closed
+// stores. Snapshot discovery itself has a separate upstream lifecycle.
+func (n *Node) evidenceHistoryContext() (context.Context, func()) {
+	work := &n.historyWork
+	work.mu.Lock()
+	defer work.mu.Unlock()
+	if work.stopping {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		return ctx, func() {}
+	}
+	if work.ctx == nil {
+		work.ctx, work.cancel = context.WithCancel(context.Background())
+	}
+	work.workers.Add(1)
+	return work.ctx, work.workers.Done
+}
+
+func (n *Node) stopEvidenceHistory() {
+	work := &n.historyWork
+	work.mu.Lock()
+	work.stopping = true
+	if work.cancel != nil {
+		work.cancel()
+	}
+	work.mu.Unlock()
+	work.workers.Wait()
+}
+
+func (n *Node) journalEvidenceHistory(chainID string) error {
+	ctx, finish := n.evidenceHistoryContext()
+	defer finish()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return writeHistoryPending(n.stateDB, chainID, 0)
+}
