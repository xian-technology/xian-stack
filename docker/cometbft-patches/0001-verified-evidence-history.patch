+func TestHistoryValidatorBoundaryDuplicateMembersReturnError(t *testing.T) {
+	_, member := validatorBoundaryFixture(t)
+	require.NotPanics(t, func() {
+		_, err := types.ValidatorSetFromExistingValidators([]*types.Validator{member, member.Copy()})
+		require.Error(t, err)
+	})
+}
