diff --git a/evidence/history_cache.go b/evidence/history_cache.go
new file mode 100644
index 0000000..3e29bbc
--- /dev/null
+++ b/evidence/history_cache.go
@@ -0,0 +1,397 @@
+package evidence
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"hash"
+	"sync"
+
+	dbm "github.com/cometbft/cometbft-db"
+	cmtjson "github.com/cometbft/cometbft/libs/json"
+	cmtproto "github.com/cometbft/cometbft/proto/tendermint/types"
+	sm "github.com/cometbft/cometbft/state"
+	"github.com/cometbft/cometbft/types"
+)
+
+// These namespaces do not overlap the pool's committed/pending evidence keys.
+var historyManifestKey = []byte{0x02}
+
+// HistoryCache contains authenticated evidence prerequisites only. The node is
+// its sole writer while state sync is paused; ordinary reads remain concurrent.
+// It never adds full blocks or validator/proposer state to the native stores.
+type HistoryCache struct {
+	db dbm.DB
+	mu sync.RWMutex
+}
+
+type historyManifest struct {
+	Version       int           `json:"version"`
+	Ready         bool          `json:"ready"`
+	Header        *types.Header `json:"header"`
+	NextHeader    *types.Header `json:"next_header"`
+	InitialHeight int64         `json:"initial_height"`
+	LowestHeight  int64         `json:"lowest_height"`
+	Count         int64         `json:"count"`
+	RecordsHash   []byte        `json:"records_hash"`
+}
+
+type historyStoredRecord struct {
+	Header *types.Header `json:"header"`
+	Commit *types.Commit `json:"commit"`
+}
+
+func NewHistoryCache(db dbm.DB) *HistoryCache { return &HistoryCache{db: db} }
+
+func (c *HistoryCache) manifest() (historyManifest, []byte, error) {
+	data, err := c.db.Get(historyManifestKey)
+	if err != nil {
+		return historyManifest{}, nil, err
+	}
+	if len(data) == 0 {
+		return historyManifest{}, nil, fmt.Errorf("evidence history cache is missing")
+	}
+	var m historyManifest
+	if err := cmtjson.Unmarshal(data, &m); err != nil {
+		return m, nil, fmt.Errorf("invalid evidence history manifest: %w", err)
+	}
+	if m.Version != 1 || m.Header == nil || m.NextHeader == nil || m.InitialHeight < 1 || m.Header.Height < m.InitialHeight {
+		return m, nil, fmt.Errorf("invalid evidence history manifest")
+	}
+	return m, data, nil
+}
+
+func (c *HistoryCache) Begin(header, next *types.Header, initialHeight int64) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if header == nil || next == nil || initialHeight < 1 || header.Height < initialHeight {
+		return fmt.Errorf("invalid history checkpoint")
+	}
+	if err := historyHeaderLink(header, next); err != nil {
+		return err
+	}
+	m := historyManifest{Version: 1, Header: header, NextHeader: next, InitialHeight: initialHeight}
+	data, err := cmtjson.Marshal(m)
+	if err != nil {
+		return err
+	}
+	// Pending is durable before any record can be considered published.
+	return c.db.SetSync(historyManifestKey, data)
+}
+
+func historyKey(prefix byte, anchor []byte, height int64) []byte {
+	key := make([]byte, 1+len(anchor)+8)
+	key[0] = prefix
+	copy(key[1:], anchor)
+	binary.BigEndian.PutUint64(key[len(key)-8:], uint64(height))
+	return key
+}
+
+func historyValidatorKey(hash []byte) []byte { return append([]byte{0x04}, hash...) }
+
+func encodeHistoryRecord(header *types.Header, vals *types.ValidatorSet, commit *types.Commit) ([]byte, []byte, error) {
+	if commit == nil {
+		return nil, nil, fmt.Errorf("missing historical commit")
+	}
+	data, err := cmtjson.Marshal(historyStoredRecord{Header: header, Commit: commit})
+	if err != nil {
+		return nil, nil, err
+	}
+	protoVals, err := vals.ToProto()
+	if err != nil {
+		return nil, nil, err
+	}
+	encodedVals, err := protoVals.Marshal()
+	return data, encodedVals, err
+}
+
+func (c *HistoryCache) Put(header *types.Header, vals *types.ValidatorSet, commit *types.Commit) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	m, _, err := c.manifest()
+	if err != nil {
+		return err
+	}
+	if err = historyPendingRecord(m, header); err != nil {
+		return err
+	}
+	if err = historyValidatorSet(header, vals); err != nil {
+		return err
+	}
+	data, encodedVals, err := encodeHistoryRecord(header, vals, commit)
+	if err != nil {
+		return err
+	}
+	batch := c.db.NewBatch()
+	defer batch.Close()
+	if err = batch.Set(historyValidatorKey(header.ValidatorsHash), encodedVals); err != nil {
+		return err
+	}
+	if err = batch.Set(historyKey(0x03, m.Header.Hash(), header.Height), data); err != nil {
+		return err
+	}
+	return batch.WriteSync()
+}
+
+func historyPendingRecord(m historyManifest, header *types.Header) error {
+	if m.Ready || header == nil || header.Height < m.InitialHeight || header.Height > m.Header.Height {
+		return fmt.Errorf("history record outside pending checkpoint")
+	}
+	return nil
+}
+
+func (c *HistoryCache) Complete(lowest, count int64) ([]byte, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	m, _, err := c.manifest()
+	if err != nil {
+		return nil, err
+	}
+	if m.Ready || lowest < m.InitialHeight || lowest > m.Header.Height || count != m.Header.Height-lowest+1 {
+		return nil, fmt.Errorf("incomplete evidence history range")
+	}
+	m.LowestHeight, m.Count = lowest, count
+	recordsHash, err := c.validateRecords(m, true)
+	if err != nil {
+		return nil, err
+	}
+	m.RecordsHash = recordsHash
+	m.Ready = true
+	data, err := cmtjson.Marshal(m)
+	if err != nil {
+		return nil, err
+	}
+	if err = c.db.SetSync(historyManifestKey, data); err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(data)
+	return digest[:], nil
+}
+
+// Validate binds the cache to an independently persisted core-state requirement.
+// It checks every retained record before the node can catch up or vote again.
+func (c *HistoryCache) Validate(requiredDigest []byte) error {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	m, data, err := c.manifest()
+	if err != nil {
+		return err
+	}
+	if !m.Ready || !m.publishedRangeValid() {
+		return fmt.Errorf("evidence history cache is incomplete")
+	}
+	digest := sha256.Sum256(data)
+	if len(requiredDigest) != 0 && !bytes.Equal(requiredDigest, digest[:]) {
+		return fmt.Errorf("evidence history checkpoint digest mismatch")
+	}
+	recordsHash, err := c.validateRecords(m, false)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(recordsHash, m.RecordsHash) {
+		return fmt.Errorf("evidence history record seal mismatch")
+	}
+	return nil
+}
+
+func (m historyManifest) publishedRangeValid() bool {
+	return m.Count > 0 && m.Count == m.Header.Height-m.LowestHeight+1 && m.LowestHeight >= m.InitialHeight && m.LowestHeight <= m.Header.Height && len(m.RecordsHash) == 32
+}
+
+func historyRecordCommit(record historyStoredRecord, vals *types.ValidatorSet, next *types.Header, signatures bool) error {
+	if record.Commit == nil {
+		return fmt.Errorf("missing historical commit")
+	}
+	if err := record.Commit.ValidateBasic(); err != nil {
+		return err
+	}
+	if record.Commit.Height != record.Header.Height || !record.Commit.BlockID.Equals(next.LastBlockID) || !bytes.Equal(record.Commit.Hash(), next.LastCommitHash) {
+		return fmt.Errorf("historical commit mismatch at %d", record.Header.Height)
+	}
+	if signatures {
+		return vals.VerifyCommit(record.Header.ChainID, next.LastBlockID, record.Header.Height, record.Commit)
+	}
+	return nil
+}
+
+func historySealRecord(seal hash.Hash, record historyStoredRecord, vals *types.ValidatorSet) error {
+	data, valBytes, err := encodeHistoryRecord(record.Header, vals, record.Commit)
+	if err != nil {
+		return err
+	}
+	for _, framed := range [][]byte{data, valBytes} {
+		var length [8]byte
+		binary.BigEndian.PutUint64(length[:], uint64(len(framed)))
+		seal.Write(length[:])
+		seal.Write(framed)
+	}
+	return nil
+}
+
+func (c *HistoryCache) validateRecords(m historyManifest, signatures bool) ([]byte, error) {
+	seal := sha256.New()
+	seal.Write([]byte("xian:evidence-history-records:v1\x00"))
+	next := m.NextHeader
+	for h := m.Header.Height; h >= m.LowestHeight; h-- {
+		record, vals, err := c.record(m, h)
+		if err != nil {
+			return nil, err
+		}
+		if err = historyHeaderLink(record.Header, next); err != nil {
+			return nil, err
+		}
+		if err = historyValidatorSet(record.Header, vals); err != nil {
+			return nil, err
+		}
+		if err = historyRecordCommit(record, vals, next, signatures); err != nil {
+			return nil, err
+		}
+		if err = historySealRecord(seal, record, vals); err != nil {
+			return nil, err
+		}
+		next = record.Header
+	}
+	return seal.Sum(nil), nil
+}
+
+func historyHeaderLink(header, next *types.Header) error {
+	if header == nil || next == nil {
+		return fmt.Errorf("missing historical header")
+	}
+	if err := header.ValidateBasic(); err != nil {
+		return err
+	}
+	if err := next.ValidateBasic(); err != nil {
+		return err
+	}
+	if next.Height != header.Height+1 || next.ChainID != header.ChainID || !next.Time.After(header.Time) || !bytes.Equal(next.LastBlockID.Hash, header.Hash()) {
+		return fmt.Errorf("historical header chain mismatch at %d", header.Height)
+	}
+	return nil
+}
+
+func historyValidatorMembers(vals *types.ValidatorSet) error {
+	seen := make(map[string]bool, len(vals.Validators))
+	for _, val := range vals.Validators {
+		if val.VotingPower <= 0 || seen[string(val.Address)] {
+			return fmt.Errorf("noncanonical historical validator")
+		}
+		seen[string(val.Address)] = true
+	}
+	return nil
+}
+
+func historyValidatorSet(header *types.Header, vals *types.ValidatorSet) error {
+	if vals == nil || vals.IsNilOrEmpty() {
+		return fmt.Errorf("missing historical validators")
+	}
+	// Shared Validator.ValidateBasic validates protocol key encodings and derived
+	// addresses before Address() can panic; proposer priorities remain irrelevant.
+	if err := vals.ValidateBasic(); err != nil {
+		return err
+	}
+	if err := historyValidatorMembers(vals); err != nil {
+		return err
+	}
+	if !bytes.Equal(vals.Hash(), header.ValidatorsHash) {
+		return fmt.Errorf("historical validator hash mismatch")
+	}
+	return nil
+}
+
+func (c *HistoryCache) record(m historyManifest, height int64) (historyStoredRecord, *types.ValidatorSet, error) {
+	var record historyStoredRecord
+	data, err := c.db.Get(historyKey(0x03, m.Header.Hash(), height))
+	if err != nil {
+		return record, nil, err
+	}
+	if len(data) == 0 {
+		return record, nil, fmt.Errorf("missing evidence history record %d", height)
+	}
+	if err = cmtjson.Unmarshal(data, &record); err != nil {
+		return record, nil, err
+	}
+	if record.Header == nil || record.Header.Height != height {
+		return record, nil, fmt.Errorf("invalid evidence history record %d", height)
+	}
+	data, err = c.db.Get(historyValidatorKey(record.Header.ValidatorsHash))
+	if err != nil {
+		return record, nil, err
+	}
+	var encoded cmtproto.ValidatorSet
+	if err = encoded.Unmarshal(data); err != nil {
+		return record, nil, err
+	}
+	vals, err := types.ValidatorSetFromProto(&encoded)
+	return record, vals, err
+}
+
+func (c *HistoryCache) publishedRecord(height int64) (historyStoredRecord, *types.ValidatorSet, error) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	m, _, err := c.manifest()
+	if err != nil {
+		return historyStoredRecord{}, nil, err
+	}
+	if !m.Ready || height < m.LowestHeight || height > m.Header.Height {
+		return historyStoredRecord{}, nil, fmt.Errorf("height %d outside published evidence history", height)
+	}
+	return c.record(m, height)
+}
+
+func (c *HistoryCache) BlockMeta(height int64) (*types.BlockMeta, error) {
+	record, _, err := c.publishedRecord(height)
+	if err != nil {
+		return nil, err
+	}
+	return &types.BlockMeta{Header: *record.Header, BlockID: record.Commit.BlockID}, nil
+}
+func (c *HistoryCache) Commit(height int64) (*types.Commit, error) {
+	record, _, err := c.publishedRecord(height)
+	return record.Commit, err
+}
+func (c *HistoryCache) Validators(height int64) (*types.ValidatorSet, error) {
+	_, vals, err := c.publishedRecord(height)
+	return vals, err
+}
+
+type historyStateStore struct {
+	sm.Store
+	cache *HistoryCache
+}
+
+func (s historyStateStore) LoadValidators(height int64) (*types.ValidatorSet, error) {
+	vals, err := s.Store.LoadValidators(height)
+	if err == nil {
+		return vals, nil
+	}
+	if cached, cacheErr := s.cache.Validators(height); cacheErr == nil {
+		return cached, nil
+	}
+	return nil, err
+}
+
+type historyBlockStore struct {
+	BlockStore
+	cache *HistoryCache
+}
+
+func (s historyBlockStore) LoadBlockMeta(height int64) *types.BlockMeta {
+	if meta := s.BlockStore.LoadBlockMeta(height); meta != nil {
+		return meta
+	}
+	meta, _ := s.cache.BlockMeta(height)
+	return meta
+}
+func (s historyBlockStore) LoadBlockCommit(height int64) *types.Commit {
+	if commit := s.BlockStore.LoadBlockCommit(height); commit != nil {
+		return commit
+	}
+	commit, _ := s.cache.Commit(height)
+	return commit
+}
+
+// HistoryCache exposes the node's single history writer without wrapping the
+// main block executor's current state or block store.
+func (p *Pool) HistoryCache() *HistoryCache { return p.historyCache }
