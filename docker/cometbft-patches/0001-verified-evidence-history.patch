+package evidence_test
+
+import (
+	"bytes"
+	"math"
+	"testing"
+	"time"
+
+	dbm "github.com/cometbft/cometbft-db"
+	"github.com/stretchr/testify/require"
+
+	"github.com/cometbft/cometbft/evidence"
+	cmtjson "github.com/cometbft/cometbft/libs/json"
+	sm "github.com/cometbft/cometbft/state"
+	"github.com/cometbft/cometbft/types"
+)
+
+type cacheAdversarialFixture struct {
+	db         dbm.DB
+	cache      *evidence.HistoryCache
+	digest     []byte
+	headers    []*types.Header
+	commits    []*types.Commit
+	validators *types.ValidatorSet
+	private    []types.PrivValidator
+}
+
+func newCacheAdversarialFixture(t *testing.T) *cacheAdversarialFixture {
+	t.Helper()
+	headers, commits, vals, private := cacheTestChain(t)
+	db := dbm.NewMemDB()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	cache := evidence.NewHistoryCache(db)
+	require.NoError(t, cache.Begin(headers[3], headers[4], 1))
+	for height := int64(3); height >= 1; height-- {
+		require.NoError(t, cache.Put(headers[height], vals, commits[height]))
+	}
+	digest, err := cache.Complete(1, 3)
+	require.NoError(t, err)
+	require.NoError(t, evidence.NewHistoryCache(db).Validate(digest))
+	return &cacheAdversarialFixture{
+		db: db, cache: cache, digest: digest, headers: headers, commits: commits,
+		validators: vals, private: private,
+	}
+}
+
+func cacheAdversarialKey(t *testing.T, db dbm.DB, prefix byte) []byte {
+	t.Helper()
+	iterator, err := db.Iterator([]byte{prefix}, []byte{prefix + 1})
+	require.NoError(t, err)
+	defer iterator.Close()
+	require.True(t, iterator.Valid(), "expected an existing published history key")
+	return append([]byte(nil), iterator.Key()...)
+}
+
+func TestHistoryCacheAdversarialMissingOrCorruptPublishedData(t *testing.T) {
+	for _, attack := range []struct {
+		name    string
+		prefix  byte
+		corrupt bool
+	}{
+		{"missing record", 0x03, false},
+		{"missing validator set", 0x04, false},
+		{"corrupt validator set", 0x04, true},
+	} {
+		t.Run(attack.name, func(t *testing.T) {
+			fixture := newCacheAdversarialFixture(t)
+			key := cacheAdversarialKey(t, fixture.db, attack.prefix)
+			if attack.corrupt {
+				require.NoError(t, fixture.db.SetSync(key, []byte{0xff}))
+			} else {
+				require.NoError(t, fixture.db.DeleteSync(key))
+			}
+			require.Error(t, evidence.NewHistoryCache(fixture.db).Validate(fixture.digest))
+		})
+	}
+}
+
+func TestHistoryCacheAdversarialCommitMetadataAfterPublication(t *testing.T) {
+	mutations := map[string]func(*types.Commit){
+		"round": func(commit *types.Commit) { commit.Round++ },
+		"part set": func(commit *types.Commit) {
+			commit.BlockID.PartSetHeader.Hash[0] ^= 0xff
+		},
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			fixture := newCacheAdversarialFixture(t)
+			key := cacheAdversarialKey(t, fixture.db, 0x03)
+			data, err := fixture.db.Get(key)
+			require.NoError(t, err)
+			var record struct {
+				Header *types.Header `json:"header"`
+				Commit *types.Commit `json:"commit"`
+			}
+			require.NoError(t, cmtjson.Unmarshal(data, &record))
+			oldHash := record.Commit.Hash()
+			mutate(record.Commit)
+			record.Commit = &types.Commit{
+				Height: record.Commit.Height, Round: record.Commit.Round,
+				BlockID: record.Commit.BlockID, Signatures: record.Commit.Signatures,
+			}
+			require.Equal(t, oldHash, record.Commit.Hash(), "metadata is not authenticated by Commit.Hash")
+			data, err = cmtjson.Marshal(record)
+			require.NoError(t, err)
+			require.NoError(t, fixture.db.SetSync(key, data))
+			require.Error(t, evidence.NewHistoryCache(fixture.db).Validate(fixture.digest))
+		})
+	}
+}
+
+func TestHistoryCacheAdversarialTimestampAfterPublicationNeverPanics(t *testing.T) {
+	for _, year := range []string{"0000", "10000"} {
+		t.Run(year, func(t *testing.T) {
+			fixture := newCacheAdversarialFixture(t)
+			key := cacheAdversarialKey(t, fixture.db, 0x03)
+			data, err := fixture.db.Get(key)
+			require.NoError(t, err)
+			var record struct {
+				Header *types.Header `json:"header"`
+				Commit *types.Commit `json:"commit"`
+			}
+			require.NoError(t, cmtjson.Unmarshal(data, &record))
+			oldTime := []byte(`"timestamp":"` + record.Commit.Signatures[0].Timestamp.Format(time.RFC3339Nano) + `"`)
+			newTime := []byte(`"timestamp":"` + year + `-01-01T00:00:00Z"`)
+			require.Contains(t, string(data), string(oldTime))
+			data = bytes.Replace(data, oldTime, newTime, 1)
+			require.NoError(t, fixture.db.SetSync(key, data))
+			require.NotPanics(t, func() {
+				require.Error(t, evidence.NewHistoryCache(fixture.db).Validate(fixture.digest))
+			})
+		})
+	}
+}
+
+type cacheAdversarialHistoricalGap struct {
+	sm.Store
+	requested int
+}
+
+func (s *cacheAdversarialHistoricalGap) LoadValidators(height int64) (*types.ValidatorSet, error) {
+	if height == 2 {
+		s.requested++
+		return nil, sm.ErrNoValSetForHeight{Height: height}
+	}
+	return s.Store.LoadValidators(height)
+}
+
+func TestHistoryCacheAdversarialPoolDoesNotChangeCoreProposerState(t *testing.T) {
+	fixture := newCacheAdversarialFixture(t)
+	base := initializeStateFromValidatorSet(fixture.validators, 4)
+	t.Cleanup(func() { require.NoError(t, base.Close()) })
+	state, err := base.Load()
+	require.NoError(t, err)
+	state.LastBlockTime = fixture.headers[4].Time
+	require.NoError(t, base.Save(state))
+	before, err := cmtjson.Marshal(state)
+	require.NoError(t, err)
+	current, err := base.LoadValidators(4)
+	require.NoError(t, err)
+	currentBytes, err := cmtjson.Marshal(current)
+	require.NoError(t, err)
+	gap := &cacheAdversarialHistoricalGap{Store: base}
+	pool, err := evidence.NewPool(fixture.db, gap, emptyHistoryBlocks{})
+	require.NoError(t, err)
+	copy, err := fixture.cache.Validators(2)
+	require.NoError(t, err)
+	copy.Validators[0].ProposerPriority = math.MaxInt64
+	copy.Validators[0].VotingPower = 1
+	proof, err := types.NewMockDuplicateVoteEvidenceWithValidator(2, fixture.headers[2].Time, fixture.private[0], evidenceChainID)
+	require.NoError(t, err)
+	require.NoError(t, pool.AddEvidence(proof))
+	require.Positive(t, gap.requested, "evidence verification must use the historical fallback")
+	state, err = base.Load()
+	require.NoError(t, err)
+	after, err := cmtjson.Marshal(state)
+	require.NoError(t, err)
+	require.Equal(t, before, after, "pool reads must not rewrite core state/proposer priorities")
+	current, err = base.LoadValidators(4)
+	require.NoError(t, err)
+	after, err = cmtjson.Marshal(current)
+	require.NoError(t, err)
+	require.Equal(t, currentBytes, after)
+	meta, err := fixture.cache.BlockMeta(2)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), meta.Header.Height)
+}
