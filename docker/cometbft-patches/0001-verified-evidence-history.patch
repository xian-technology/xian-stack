+func TestHistoryValidatorBoundaryLightRPCPaginationBounds(t *testing.T) {
+	cases := []struct {
+		name                                         string
+		firstSize, firstTotal, laterSize, laterTotal int
+		requests                                     int32
+	}{
+		{"oversized page", 101, 10000, 101, 10000, 1},
+		{"oversized total", 100, 10001, 100, 10001, 1},
+		{"changing total", 100, 101, 1, 102, 2},
+		{"cumulative over total", 100, 101, 2, 101, 2},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			committed, member := validatorBoundaryFixture(t)
+			var requests atomic.Int32
+			page := func(call int32) *coretypes.ResultValidators {
+				size, total := tc.firstSize, tc.firstTotal
+				if call > 1 {
+					size, total = tc.laterSize, tc.laterTotal
+				}
+				members := make([]*types.Validator, size)
+				for i := range members {
+					members[i] = member.Copy()
+				}
+				return &coretypes.ResultValidators{BlockHeight: 1, Validators: members, Count: size, Total: total}
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				validatorBoundaryRPC(t, w, r, committed, page, &requests)
+			}))
+			defer server.Close()
+			provider, err := lighthttp.New("history-key-boundary", server.URL)
+			require.NoError(t, err)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			_, err = provider.LightBlock(ctx, 1)
+			require.Error(t, err)
+			require.Equal(t, tc.requests, requests.Load(), "reject the first invalid page before fetching or retaining more validators")
+		})
+	}
+}
