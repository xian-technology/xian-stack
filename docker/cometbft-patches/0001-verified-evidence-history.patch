+)
+
+type proofHistoryFixture struct {
+	meta   *types.BlockMeta
+	commit *types.Commit
+	vals   *types.ValidatorSet
+	err    error
+}
+
+func (f proofHistoryFixture) BlockMeta(int64) (*types.BlockMeta, error)     { return f.meta, f.err }
+func (f proofHistoryFixture) Commit(int64) (*types.Commit, error)           { return f.commit, f.err }
+func (f proofHistoryFixture) Validators(int64) (*types.ValidatorSet, error) { return f.vals, f.err }
+
+func TestEvidenceHistoryRetainedProofBelowBodyBase(t *testing.T) {
+	for _, cached := range []bool{false, true} {
+		t.Run(fmt.Sprint(cached), func(t *testing.T) {
+			height := int64(4)
+			vals, _ := types.RandValidatorSet(2, 10)
+			meta := &types.BlockMeta{Header: types.Header{Height: height}}
+			commit := &types.Commit{Height: height}
+			blocks := &mocks.BlockStore{}
+			blocks.On("Height").Return(int64(10))
+			blocks.On("Base").Return(int64(8))
+			state := &mocks.Store{}
+			env := &Environment{BlockStore: blocks, StateStore: state}
+			if cached {
+				blocks.On("LoadBlockMeta", height).Return((*types.BlockMeta)(nil))
+				env.EvidenceHistory = proofHistoryFixture{meta: meta, commit: commit, vals: vals}
+			} else {
+				blocks.On("LoadBlockMeta", height).Return(meta)
+				blocks.On("LoadBlockCommit", height).Return(commit)
+				state.On("LoadValidators", height).Return(vals, nil)
+			}
+			proof, err := env.EvidenceHistoryRecord(nil, height)
+			require.NoError(t, err)
+			require.Equal(t, height, proof.Header.Height)
+			require.Equal(t, vals, proof.Validators)
+			require.Equal(t, commit, proof.Commit)
+			_, err = env.Block(nil, &height)
+			require.ErrorContains(t, err, "not available")
+			require.Contains(t, env.GetRoutes(), "evidence_history")
+		})
+	}
+}
+
+func TestEvidenceHistoryUnavailableAndInvalidHeight(t *testing.T) {
+	blocks := &mocks.BlockStore{}
+	blocks.On("Height").Return(int64(10))
+	blocks.On("LoadBlockMeta", int64(4)).Return((*types.BlockMeta)(nil))
+	env := &Environment{BlockStore: blocks, StateStore: sm.NewStore(dbm.NewMemDB(), sm.StoreOptions{})}
+	for _, height := range []int64{-1, 0, 4, 11} {
+		_, err := env.EvidenceHistoryRecord(nil, height)
+		require.Error(t, err)
+	}
+	env.EvidenceHistory = proofHistoryFixture{err: fmt.Errorf("missing")}
+	_, err := env.EvidenceHistoryRecord(nil, 4)
+	require.Error(t, err)
+}
