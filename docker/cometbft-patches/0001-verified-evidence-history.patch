+++ b/statesync/history_offer_mock_test.go
@@ -0,0 +1,74 @@
+package statesync
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"sync"
+
+	abci "github.com/cometbft/cometbft/abci/types"
+	proxymocks "github.com/cometbft/cometbft/proxy/mocks"
+	"github.com/stretchr/testify/mock"
+)
+
+// Keep the upstream syncer expectations about original snapshot metadata. This
+// app-side test double enforces the private, single-use local pairing first.
+type historyOfferPairing struct {
+	mu    sync.Mutex
+	nonce string
+}
+type historySnapshotMock struct {
+	*proxymocks.AppConnSnapshot
+	pair *historyOfferPairing
+}
+
+func historyPairedMockConnections() (*proxymocks.AppConnQuery, *historySnapshotMock) {
+	pair := &historyOfferPairing{}
+	query := &proxymocks.AppConnQuery{}
+	query.On("Echo", mock.Anything, mock.AnythingOfType("string")).Maybe().Return(func(_ context.Context, message string) (*abci.ResponseEcho, error) {
+		nonce := strings.TrimPrefix(message, "xian-evidence-history/1:")
+		if len(nonce) != 64 || nonce == message {
+			return nil, fmt.Errorf("invalid private pairing")
+		}
+		pair.mu.Lock()
+		pair.nonce = nonce
+		pair.mu.Unlock()
+		return &abci.ResponseEcho{Message: "xian-evidence-history/1:registered:" + nonce}, nil
+	})
+	return query, &historySnapshotMock{AppConnSnapshot: &proxymocks.AppConnSnapshot{}, pair: pair}
+}
+
+func (m *historySnapshotMock) OfferSnapshot(ctx context.Context, request *abci.RequestOfferSnapshot) (*abci.ResponseOfferSnapshot, error) {
+	m.pair.mu.Lock()
+	nonce := m.pair.nonce
+	m.pair.nonce = ""
+	m.pair.mu.Unlock()
+	var wrapper struct {
+		SchemaVersion int    `json:"schema_version"`
+		Nonce         string `json:"xian_evidence_history_nonce"`
+		Metadata      string `json:"metadata"`
+	}
+	if request.Snapshot == nil {
+		return nil, fmt.Errorf("missing snapshot")
+	}
+	if err := json.Unmarshal(request.Snapshot.Metadata, &wrapper); err != nil {
+		return nil, err
+	}
+	if wrapper.SchemaVersion != 1 || nonce == "" || wrapper.Nonce != nonce {
+		return nil, fmt.Errorf("unpaired offer")
+	}
+	metadata, err := base64.StdEncoding.DecodeString(wrapper.Metadata)
+	if err != nil {
+		return nil, err
+	}
+	if len(metadata) == 0 {
+		metadata = nil
+	}
+	copyRequest := *request
+	copySnapshot := *request.Snapshot
+	copySnapshot.Metadata = metadata
+	copyRequest.Snapshot = &copySnapshot
+	return m.AppConnSnapshot.OfferSnapshot(ctx, &copyRequest)
+}
