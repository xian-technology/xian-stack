diff --git a/rpc/core/evidence_history.go b/rpc/core/evidence_history.go
new file mode 100644
index 0000000..326747f
--- /dev/null
+++ b/rpc/core/evidence_history.go
@@ -0,0 +1,72 @@
+package core
+
+import (
+	"fmt"
+
+	ctypes "github.com/cometbft/cometbft/rpc/core/types"
+	rpctypes "github.com/cometbft/cometbft/rpc/jsonrpc/types"
+	"github.com/cometbft/cometbft/types"
+)
+
+// EvidenceHistory is a proof-only read interface. Its validators do not convey
+// current proposer priorities, and it never supplies block bodies.
+type EvidenceHistory interface {
+	BlockMeta(int64) (*types.BlockMeta, error)
+	Commit(int64) (*types.Commit, error)
+	Validators(int64) (*types.ValidatorSet, error)
+}
+
+func (env *Environment) retainedEvidenceHistory(height int64) (*ctypes.ResultEvidenceHistory, error) {
+	meta := env.BlockStore.LoadBlockMeta(height)
+	if meta == nil {
+		return nil, fmt.Errorf("historical header unavailable")
+	}
+	commit := env.BlockStore.LoadBlockCommit(height)
+	if commit == nil {
+		return nil, fmt.Errorf("canonical historical commit unavailable")
+	}
+	vals, err := env.StateStore.LoadValidators(height)
+	if err != nil {
+		return nil, err
+	}
+	return &ctypes.ResultEvidenceHistory{Header: &meta.Header, Commit: commit, Validators: vals}, nil
+}
+
+func (env *Environment) cachedEvidenceHistory(height int64) (*ctypes.ResultEvidenceHistory, error) {
+	if env.EvidenceHistory == nil {
+		return nil, fmt.Errorf("evidence history unavailable")
+	}
+	meta, err := env.EvidenceHistory.BlockMeta(height)
+	if err != nil {
+		return nil, err
+	}
+	commit, err := env.EvidenceHistory.Commit(height)
+	if err != nil {
+		return nil, err
+	}
+	vals, err := env.EvidenceHistory.Validators(height)
+	if err != nil {
+		return nil, err
+	}
+	return &ctypes.ResultEvidenceHistory{Header: &meta.Header, Commit: commit, Validators: vals}, nil
+}
+
+// EvidenceHistoryRecord serves the retained proof window even below the block
+// body pruning base. Ordinary /block and /validators keep their own semantics.
+// Clients must authenticate every returned record against a trusted header.
+func (env *Environment) EvidenceHistoryRecord(_ *rpctypes.Context, height int64) (*ctypes.ResultEvidenceHistory, error) {
+	if height <= 0 || height >= env.BlockStore.Height() {
+		return nil, fmt.Errorf("evidence history requires a positive historical height")
+	}
+	record, err := env.retainedEvidenceHistory(height)
+	if err != nil {
+		record, err = env.cachedEvidenceHistory(height)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("evidence history unavailable at height %d", height)
+	}
+	if record.Header == nil || record.Commit == nil || record.Validators == nil || len(record.Validators.Validators) > 10000 {
+		return nil, fmt.Errorf("evidence history record incomplete or exceeds validator limit")
+	}
+	return record, nil
+}
