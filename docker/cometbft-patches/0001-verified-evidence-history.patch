+package statesync
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	abci "github.com/cometbft/cometbft/abci/types"
+	"github.com/stretchr/testify/require"
+)
+
+type historyEchoStub func(context.Context, string) (*abci.ResponseEcho, error)
+
+func (f historyEchoStub) Echo(ctx context.Context, message string) (*abci.ResponseEcho, error) {
+	return f(ctx, message)
+}
+
+func TestHistoryOfferPrivatePairingKeepsNetworkMetadataOriginal(t *testing.T) {
+	original := []byte("network snapshot metadata")
+	var nonces []string
+	echo := historyEchoStub(func(_ context.Context, message string) (*abci.ResponseEcho, error) {
+		require.True(t, strings.HasPrefix(message, "xian-evidence-history/1:"))
+		nonce := strings.TrimPrefix(message, "xian-evidence-history/1:")
+		require.Len(t, nonce, 64)
+		nonces = append(nonces, nonce)
+		return &abci.ResponseEcho{Message: "xian-evidence-history/1:registered:" + nonce}, nil
+	})
+	for i := 0; i < 2; i++ {
+		wrapped, err := historyOfferMetadata(context.Background(), echo, original)
+		require.NoError(t, err)
+		var payload struct {
+			SchemaVersion int    `json:"schema_version"`
+			Nonce         string `json:"xian_evidence_history_nonce"`
+			Metadata      string `json:"metadata"`
+		}
+		require.NoError(t, json.Unmarshal(wrapped, &payload))
+		require.Equal(t, 1, payload.SchemaVersion)
+		require.Equal(t, nonces[i], payload.Nonce)
+		decoded, err := base64.StdEncoding.DecodeString(payload.Metadata)
+		require.NoError(t, err)
+		require.Equal(t, original, decoded)
+	}
+	require.NotEqual(t, nonces[0], nonces[1])
+	require.Equal(t, []byte("network snapshot metadata"), original)
+}
+
+func TestHistoryOfferRefusesStockEchoOrWrongAcknowledgement(t *testing.T) {
+	for _, reply := range []string{"stock", "xian-evidence-history/1:registered:wrong"} {
+		_, err := historyOfferMetadata(context.Background(), historyEchoStub(func(_ context.Context, msg string) (*abci.ResponseEcho, error) {
+			if reply == "stock" {
+				reply = msg
+			}
+			return &abci.ResponseEcho{Message: reply}, nil
+		}), nil)
+		require.Error(t, err)
+	}
+}
+
+func TestHistoryOfferErrorCannotExposePrivateCapability(t *testing.T) {
+	_, err := historyOfferMetadata(context.Background(), historyEchoStub(func(_ context.Context, message string) (*abci.ResponseEcho, error) {
+		return nil, errors.New(message)
+	}), nil)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "xian-evidence-history/1:")
+}
diff --git a/statesync/history_transport.go b/statesync/history_transport.go
new file mode 100644
index 0000000..777fe59
--- /dev/null
+++ b/statesync/history_transport.go
@@ -0,0 +1,67 @@
+package statesync
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+
+	rpchttp "github.com/cometbft/cometbft/rpc/client/http"
+	jsonrpcclient "github.com/cometbft/cometbft/rpc/jsonrpc/client"
+)
+
+// The trusted light-anchor fetch is a network boundary too. Its existing RPC
+// decoder otherwise reads an unbounded body before verifying the response.
+type historyBoundedTransport struct {
+	base    http.RoundTripper
+	maximum int64
+}
+
+func (t historyBoundedTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	response, err := t.base.RoundTrip(request)
+	if err != nil {
+		return nil, err
+	}
+	if response.ContentLength > t.maximum {
+		response.Body.Close()
+		return nil, fmt.Errorf("light RPC response exceeds history byte limit")
+	}
+	response.Body = &historyBoundedBody{ReadCloser: response.Body, remaining: t.maximum}
+	return response, nil
+}
+
+type historyBoundedBody struct {
+	io.ReadCloser
+	remaining int64
+}
+
+func (b *historyBoundedBody) Read(target []byte) (int, error) {
+	if len(target) == 0 {
+		return 0, nil
+	}
+	if b.remaining == 0 {
+		var probe [1]byte
+		n, err := b.ReadCloser.Read(probe[:])
+		if n > 0 {
+			return 0, fmt.Errorf("light RPC response exceeds history byte limit")
+		}
+		return 0, err
+	}
+	if int64(len(target)) > b.remaining {
+		target = target[:b.remaining]
+	}
+	n, err := b.ReadCloser.Read(target)
+	b.remaining -= int64(n)
+	return n, err
+}
+
+func boundedHistoryLightRPC(server string) (*rpchttp.HTTP, error) {
+	client, err := jsonrpcclient.DefaultHTTPClient(server)
+	if err != nil {
+		return nil, err
+	}
+	limits := DefaultHistoryLimits()
+	client.Timeout = limits.RequestTimeout
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	client.Transport = historyBoundedTransport{base: client.Transport, maximum: limits.MaxResponseBytes}
+	return rpchttp.NewWithClient(server, "/websocket", client)
+}
