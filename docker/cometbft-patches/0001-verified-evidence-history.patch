+package statesync
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestHistoryLightRPCTransportRejectsOversizedAnchorResponse(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"jsonrpc":"2.0","id":0,"result":{}}`)
+		io.WriteString(w, strings.Repeat(" ", int(DefaultHistoryLimits().MaxResponseBytes)))
+	}))
+	defer server.Close()
+	client, err := rpcClient(server.URL)
+	require.NoError(t, err)
+	_, err = client.Status(context.Background())
+	require.ErrorContains(t, err, "byte limit")
+}
+
+func TestHistoryLightBodyAcceptsExactBudgetAndRefusesExtraByte(t *testing.T) {
+	for _, size := range []int{4, 5} {
+		body := &historyBoundedBody{ReadCloser: io.NopCloser(strings.NewReader(strings.Repeat("x", size))), remaining: 4}
+		data, err := io.ReadAll(body)
+		require.Len(t, data, 4)
+		if size == 4 {
+			require.NoError(t, err)
+		} else {
+			require.ErrorContains(t, err, "byte limit")
+		}
+	}
+}
