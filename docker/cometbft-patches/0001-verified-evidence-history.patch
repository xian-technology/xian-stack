+	config.StateSync.HistoryMaxBytes = 1
+	_, _, err = prepareEvidenceHistory(context.Background(), config, state, genesis, historyVerifiedProvider{anchor: anchor}, query, cache)
+	require.Error(t, err)
+	require.Error(t, cache.Validate(digest))
