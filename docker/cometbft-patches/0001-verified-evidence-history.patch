+	cmtversion "github.com/cometbft/cometbft/proto/tendermint/version"
+	"github.com/cometbft/cometbft/types"
+	"github.com/cometbft/cometbft/version"
+)
+
+func cacheTestChain(t *testing.T) ([]*types.Header, []*types.Commit, *types.ValidatorSet, []types.PrivValidator) {
+	t.Helper()
+	vals, private := types.RandValidatorSet(1, 10)
+	headers := make([]*types.Header, 5)
+	commits := make([]*types.Commit, 5)
+	var previous types.BlockID
+	for h := int64(1); h <= 4; h++ {
+		header := &types.Header{
+			Version: cmtversion.Consensus{Block: version.BlockProtocol}, ChainID: evidenceChainID,
+			Height: h, Time: defaultEvidenceTime.Add(time.Duration(h)), LastBlockID: previous,
+			LastCommitHash: commits[h-1].Hash(), ValidatorsHash: vals.Hash(), NextValidatorsHash: vals.Hash(),
+			ProposerAddress: vals.Validators[0].Address,
+		}
+		id := cmttest.MakeBlockIDWithHash(header.Hash())
+		commit, err := cmttest.MakeCommit(id, h, 0, vals, private, header.ChainID, header.Time)
+		require.NoError(t, err)
+		headers[h], commits[h], previous = header, commit, id
+	}
+	return headers, commits, vals, private
+}
+
+func TestHistoryCachePublicationAndRestart(t *testing.T) {
+	db := dbm.NewMemDB()
+	cache := evidence.NewHistoryCache(db)
+	headers, commits, vals, _ := cacheTestChain(t)
+	require.NoError(t, cache.Begin(headers[3], headers[4], 1))
+	require.Error(t, cache.Validate(nil))
+	for h := int64(3); h >= 1; h-- {
+		require.NoError(t, cache.Put(headers[h], vals, commits[h]))
+	}
+	digest, err := cache.Complete(1, 3)
+	require.NoError(t, err)
+	require.Len(t, digest, 32)
+	restarted := evidence.NewHistoryCache(db)
+	require.NoError(t, restarted.Validate(digest))
+	meta, err := restarted.BlockMeta(2)
+	require.NoError(t, err)
+	require.Equal(t, headers[2].Hash(), meta.Header.Hash())
+	commit, err := restarted.Commit(2)
+	require.NoError(t, err)
+	require.Equal(t, commits[2].Hash(), commit.Hash())
+	set, err := restarted.Validators(2)
+	require.NoError(t, err)
+	require.Equal(t, vals.Hash(), set.Hash())
+	require.Error(t, restarted.Validate(make([]byte, 32)))
+	require.Error(t, restarted.Validate([]byte{1}))
+}
+
+func TestHistoryCacheRejectsMalformedCheckpointLinksAndManifest(t *testing.T) {
+	for _, kind := range []string{"missing", "header", "next", "height", "chain", "time", "hash"} {
+		t.Run(kind, func(t *testing.T) {
+			headers, _, _, _ := cacheTestChain(t)
+			header, next := headers[3], headers[4]
+			switch kind {
+			case "missing":
+				header = nil
+			case "header":
+				header.Height = 0
+			case "next":
+				next.Height = 0
+			case "height":
+				next.Height++
+			case "chain":
+				next.ChainID = "wrong"
+			case "time":
+				next.Time = header.Time
+			case "hash":
+				next.LastBlockID.Hash = make([]byte, 32)
+			}
+			cache := evidence.NewHistoryCache(dbm.NewMemDB())
+			require.Error(t, cache.Begin(header, next, 1))
+			require.Error(t, cache.Validate(nil))
+		})
+	}
+	for _, data := range [][]byte{[]byte("{"), []byte("{}"), []byte(`{"version":2}`)} {
+		db := dbm.NewMemDB()
+		require.NoError(t, db.SetSync([]byte{2}, data))
+		require.Error(t, evidence.NewHistoryCache(db).Validate(nil))
+	}
+}
+
+func TestHistoryCacheRefusesHolesAndChangedCommitBeforePublication(t *testing.T) {
+	headers, commits, vals, _ := cacheTestChain(t)
+	for _, missing := range []bool{true, false} {
+		cache := evidence.NewHistoryCache(dbm.NewMemDB())
+		require.NoError(t, cache.Begin(headers[3], headers[4], 1))
+		for h := int64(3); h >= 1; h-- {
+			if missing && h == 2 {
+				continue
+			}
+			commit := commits[h].Clone()
+			if !missing && h == 2 {
+				commit.Signatures[0].Timestamp = commit.Signatures[0].Timestamp.Add(time.Second)
+			}
+			require.NoError(t, cache.Put(headers[h], vals, commit))
+		}
+		_, err := cache.Complete(1, 3)
+		require.Error(t, err)
+	}
+}
+
+func TestHistoryCacheRejectsChangedUnsignedCommitRoundBeforePublication(t *testing.T) {
+	headers, commits, vals, _ := cacheTestChain(t)
+	cache := evidence.NewHistoryCache(dbm.NewMemDB())
+	require.NoError(t, cache.Begin(headers[3], headers[4], 1))
+	for h := int64(3); h >= 1; h-- {
+		commit := commits[h].Clone()
+		if h == 2 {
+			commit.Round++
+			require.Equal(t, commits[h].Hash(), commit.Hash())
+		}
+		require.NoError(t, cache.Put(headers[h], vals, commit))
+	}
+	_, err := cache.Complete(1, 3)
+	require.Error(t, err)
+	require.Error(t, cache.Validate(nil))
+}
+
+func TestHistoryCacheMakesPrecheckpointProofVerifiableWithoutFullBlock(t *testing.T) {
+	db := dbm.NewMemDB()
+	headers, commits, vals, private := cacheTestChain(t)
+	cache := evidence.NewHistoryCache(db)
+	require.NoError(t, cache.Begin(headers[3], headers[4], 1))
+	for h := int64(3); h >= 1; h-- {
+		require.NoError(t, cache.Put(headers[h], vals, commits[h]))
+	}
+	_, err := cache.Complete(1, 3)
+	require.NoError(t, err)
+	stateStore := initializeStateFromValidatorSet(vals, 4)
+	pool, err := evidence.NewPool(db, stateStore, emptyHistoryBlocks{})
+	require.NoError(t, err)
+	proof, err := types.NewMockDuplicateVoteEvidenceWithValidator(2, headers[2].Time, private[0], evidenceChainID)
+	require.NoError(t, err)
+	require.NoError(t, pool.AddEvidence(proof))
+	set, err := stateStore.LoadValidators(2)
+	require.NoError(t, err)
+	require.Equal(t, vals.Hash(), set.Hash())
+}
+
+type emptyHistoryBlocks struct{}
+
+func (emptyHistoryBlocks) LoadBlockMeta(int64) *types.BlockMeta { return nil }
+func (emptyHistoryBlocks) LoadBlockCommit(int64) *types.Commit  { return nil }
+func (emptyHistoryBlocks) Height() int64                        { return 4 }
