+// EvidenceHistoryAnchor exposes only the existing light client's verified
+// checkpoint and successor. Ordinary RPC history can never supply this root.
+func (s *lightClientStateProvider) EvidenceHistoryAnchor(ctx context.Context, height uint64) (HistoryAnchor, error) {
+	s.Lock()
+	defer s.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	header, err := s.lc.VerifyLightBlockAtHeight(ctx, int64(height), time.Now())
+	if err != nil {
+		return HistoryAnchor{}, err
+	}
+	next, err := s.lc.VerifyLightBlockAtHeight(ctx, int64(height+1), time.Now())
+	if err != nil {
+		return HistoryAnchor{}, err
+	}
+	initial := s.initialHeight
+	if initial == 0 {
+		initial = 1
+	}
+	return HistoryAnchor{Header: header.Header, NextHeader: next.Header, InitialHeight: initial}, nil
+}
+
