+func TestHistoryPrepareAuthenticatesActualRPCRecordsAndPublishesCache(t *testing.T) {
+	state, anchor, record, query, genesis := historyProtocolFixture(t)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var result any
+		switch r.URL.Path {
+		case "/commit":
+			result = coretypes.NewResultCommit(record.Header, record.Commit, true)
+		case "/validators":
+			result = &coretypes.ResultValidators{BlockHeight: 1, Validators: record.Validators.Validators, Count: 1, Total: 1}
+		default:
+			http.NotFound(w, r)
+			return
+		}
+		encodedResult, err := cmtjson.Marshal(result)
+		if err != nil {
+			http.Error(w, err.Error(), 500)
+			return
+		}
+		encoded, err := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": -1, "result": json.RawMessage(encodedResult)})
+		if err != nil {
+			http.Error(w, err.Error(), 500)
+			return
+		}
+		w.Write(encoded)
+	}))
+	defer server.Close()
+	config := cfg.DefaultConfig()
+	config.StateSync.RPCServers = []string{server.URL}
