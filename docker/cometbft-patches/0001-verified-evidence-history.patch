+
+func historyProtocolFixture(t *testing.T) (sm.State, statesync.HistoryAnchor, statesync.HistoryRecord, historyQueryStub, *types.GenesisDoc) {
+	t.Helper()
+	private := types.NewMockPV()
+	pub, err := private.GetPubKey()
+	require.NoError(t, err)
+	vals := types.NewValidatorSet([]*types.Validator{types.NewValidator(pub, 10)})
+	params := types.DefaultConsensusParams()
+	header := &types.Header{Version: cmtversion.Consensus{Block: version.BlockProtocol, App: 7}, ChainID: "protocol-history", Height: 1, Time: time.Date(2500, 1, 1, 0, 0, 0, 1, time.UTC), ValidatorsHash: vals.Hash(), NextValidatorsHash: vals.Hash(), ProposerAddress: pub.Address(), ConsensusHash: params.Hash()}
+	id := cmttest.MakeBlockIDWithHash(header.Hash())
+	commit, err := cmttest.MakeCommit(id, 1, 0, vals, []types.PrivValidator{private}, header.ChainID, header.Time)
+	require.NoError(t, err)
+	next := *header
+	next.Height = 2
+	next.Time = header.Time.Add(time.Nanosecond)
+	next.LastBlockID = id
+	next.LastCommitHash = commit.Hash()
+	next.AppHash = bytes.Repeat([]byte{2}, 32)
+	state := sm.State{ChainID: header.ChainID, InitialHeight: 1, LastBlockHeight: 1, LastBlockTime: header.Time, LastBlockID: id, AppHash: next.AppHash, ConsensusParams: *params}
+	state.ConsensusParams.Evidence.MaxAgeDuration = 1
+	body := map[string]any{"schema_version": 1, "height": "1", "app_hash": hex.EncodeToString(next.AppHash), "last_block_nanos": exactHistoryNanos(header.Time), "evidence": map[string]string{"max_age_num_blocks": "100000", "max_age_duration": "1296000000000000", "max_bytes": "1048576"}}
+	encoded, err := json.Marshal(body)
+	require.NoError(t, err)
+	query := historyQueryStub{info: &abci.ResponseInfo{LastBlockHeight: 1, LastBlockAppHash: next.AppHash, AppVersion: 7}, query: &abci.ResponseQuery{Height: 1, Value: encoded}}
+	return state, statesync.HistoryAnchor{Header: header, NextHeader: &next, InitialHeight: 1}, statesync.HistoryRecord{Header: header, Validators: vals, Commit: commit}, query, &types.GenesisDoc{ChainID: header.ChainID, ConsensusParams: params}
+}
