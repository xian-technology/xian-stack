+package node
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	dbm "github.com/cometbft/cometbft-db"
+	cfg "github.com/cometbft/cometbft/config"
+	"github.com/cometbft/cometbft/libs/log"
+	"github.com/cometbft/cometbft/libs/service"
+	"github.com/cometbft/cometbft/p2p"
+	sm "github.com/cometbft/cometbft/state"
+	"github.com/cometbft/cometbft/types"
+	"github.com/stretchr/testify/require"
+)
+
+type historyClosingStore struct {
+	sm.Store
+	closed chan struct{}
+}
+
+func (s historyClosingStore) Close() error {
+	close(s.closed)
+	return s.Store.Close()
+}
+
+func TestHistoryRealNodeStopCancelsAndJoinsBeforeClosingStores(t *testing.T) {
+	db := dbm.NewMemDB()
+	closed := make(chan struct{})
+	n := &Node{stateDB: db, eventBus: types.NewEventBus(), sw: p2p.NewSwitch(cfg.DefaultP2PConfig(), nil), stateStore: historyClosingStore{Store: sm.NewStore(db, sm.StoreOptions{}), closed: closed}}
+	n.BaseService = *service.NewBaseService(log.NewNopLogger(), "history-shutdown", n)
+	require.NoError(t, n.journalEvidenceHistory("shutdown-chain"))
+	journal, err := readHistoryRequirement(db)
+	require.NoError(t, err)
+	require.True(t, journal.Pending)
+	ctx, finish := n.evidenceHistoryContext()
+	var once sync.Once
+	release := func() { once.Do(finish) }
+	defer release()
+	stopped := make(chan struct{})
+	go func() { n.OnStop(); close(stopped) }()
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Error("real OnStop did not cancel active history before waiting for Quit")
+	}
+	select {
+	case <-closed:
+		t.Error("store closed while history publication was still active")
+	default:
+	}
+	release()
+	select {
+	case <-stopped:
+	case <-time.After(time.Second):
+		t.Fatal("OnStop did not join completed history work")
+	}
+	require.Eventually(t, func() bool {
+		select {
+		case <-closed:
+			return true
+		default:
+			return false
+		}
+	}, time.Second, time.Millisecond)
+	late, lateFinish := n.evidenceHistoryContext()
+	defer lateFinish()
+	require.ErrorIs(t, late.Err(), context.Canceled, "late snapshot completion must not begin history work after stores close")
+	require.ErrorIs(t, n.journalEvidenceHistory("shutdown-chain"), context.Canceled)
+}
