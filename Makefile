$(strip $(shell XIAN_STACK_SECRETS_ENV='$(abspath $(XIAN_STACK_SECRETS_ENV))' bash -lc 'source ./scripts/stack-env.sh >/dev/null 2>&1; ensure_stack_secrets_env >/dev/null; printf "%s" "$${$(1)}"'))
endef

