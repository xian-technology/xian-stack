	$(DOCKER_COMPOSE) --profile fidelity --profile dashboard-fidelity -f docker-compose-abci.yml up -d $(DASHBOARD_UP_BUILD_FLAG) abci-app cometbft dashboard-fidelity

dashboard-fidelity-down:
